# Normalize text to CRLF in every working tree so Linux CI and Windows
# agents match root .editorconfig (end_of_line = crlf). Without this,
# git stores LF and Linux checkouts fail `dotnet format --verify-no-changes`
# on ENDOFLINE while Windows with core.autocrlf=true stays green.
* text=auto eol=crlf

# Shell scripts must stay LF for execution on Linux runners/containers.
*.sh text eol=lf

# GitHub Actions workflows stay LF so Linux Dependabot and other checkouts
# cannot rewrite whole files to CRLF and hide real `uses:` edits in review.
.github/workflows/*.yml text eol=lf

# Cloudflare Worker source snapshots must match the live published script
# byte-for-byte (a live #626 plan confirmed the exact line endings each
# script was actually published with) so `content = file(...)` imports
# with zero diff on any OS. pictures-queenzone-org.js already matches the
# repo default (eol=crlf); pictures-legacy-redirect.js needs LF instead.
infra/import/workers/pictures-legacy-redirect.js text eol=lf

# Expo / Node sources stay LF so Metro, npm, and Linux mobile CI match
# Expo defaults. Binary rules below still apply to images under this tree.
src/QueenZone.Mobile/**/*.js text eol=lf
src/QueenZone.Mobile/**/*.ts text eol=lf
src/QueenZone.Mobile/**/*.tsx text eol=lf
src/QueenZone.Mobile/**/*.json text eol=lf
src/QueenZone.Mobile/**/*.md text eol=lf
src/QueenZone.Mobile/**/*.yaml text eol=lf
src/QueenZone.Mobile/**/*.yml text eol=lf
src/QueenZone.Mobile/**/.gitignore text eol=lf
src/QueenZone.Mobile/**/.nvmrc text eol=lf
src/QueenZone.Mobile/**/.node-version text eol=lf

