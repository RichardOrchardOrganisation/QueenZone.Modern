      "id": "data.datetimeoffset-order-or-collation",
      "paths": [
        "src/QueenZone.Data/Repositories/EfEditorialArticleRepository.cs",
        "src/QueenZone.Data/Repositories/EfArticleRepository.cs",
        "tests/QueenZone.Web.Tests/EfEditorialArticleRepositoryTests.cs",
