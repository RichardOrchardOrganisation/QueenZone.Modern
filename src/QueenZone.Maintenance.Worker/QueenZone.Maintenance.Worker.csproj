<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuses the web project's purge and sweep services as-is (#1677); do not fork them here. -->
    <ProjectReference Include="..\QueenZone.Web\QueenZone.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- QueenZone.Web's appsettings*.json flow through the project reference and can overwrite
       the worker's own files. Keep only this project's configuration in the output. -->
  <PropertyGroup>
    <_QueenZoneWebDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\QueenZone.Web\'))</_QueenZoneWebDirectory>
  </PropertyGroup>

  <Target Name="ExcludeWebAppSettings" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_WebAppSettingsItem Include="@(_TransitiveItemsToCopyToOutputDirectory);@(_SourceItemsToCopyToOutputDirectory);@(_SourceItemsToCopyToOutputDirectoryAlways)"
                           Condition="'%(RootDir)%(Directory)' == '$(_QueenZoneWebDirectory)' And $([System.String]::Copy('%(Filename)').StartsWith('appsettings'))" />
      <_TransitiveItemsToCopyToOutputDirectory Remove="@(_WebAppSettingsItem)" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_WebAppSettingsItem)" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_WebAppSettingsItem)" />
      <AllItemsFullPathWithTargetPath Remove="@(_WebAppSettingsItem)" />
    </ItemGroup>
  </Target>

</Project>
