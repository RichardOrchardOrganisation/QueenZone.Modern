{
  "expo": {
    "name": "QueenZone",
    "slug": "queenzone-mobile",
    "scheme": "queenzone",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.queenzone.mobile"
    },
    "android": {
      "package": "org.queenzone.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111111",
          "dark": {
            "backgroundColor": "#111111"
          },
          "imageWidth": 200
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QueenZone to use your photos for gallery submissions, forum posts, and your member avatar.",
          "cameraPermission": "Allow QueenZone to use the camera for gallery submissions and your member avatar."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow QueenZone to save pictures to your photo library.",
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosAppGroupIdentifier": "group.org.queenzone.mobile",
          "androidIntentFilters": ["text/*"]
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.org.queenzone.mobile",
          "widgets": [
            {
              "name": "OnThisDayWidget",
              "displayName": "On This Day",
              "description": "A Queen history highlight and a rolling random quote.",
              "supportedFamilies": ["systemSmall", "systemMedium"],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "OnThisDayWidget",
              "label": "On This Day",
              "description": "A Queen history highlight and a rolling random quote.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/android-widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 14400000
            }
          ]
        }
      ],
      "expo-background-task",
      "@sentry/react-native/expo"
    ]
  }
}
