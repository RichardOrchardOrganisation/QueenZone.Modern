{
  "name": "queenzone-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24 <25"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "queenzone-wallpaper"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "coverage:gate": "node ../../scripts/Test-TypeScriptCoverageGate.mjs",
    "coverage": "npm run test:coverage && npm run coverage:gate",
    "test:api-contracts": "node scripts/run-api-contracts.mjs",
    "doctor": "expo-doctor",
    "preflight": "node ../../scripts/check-feature-map.mjs && npm run typecheck && npm run lint && npm test && npm run doctor",
    "audit:gate": "node scripts/check-npm-advisories.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~58.0.25",
    "@native-html/render": "^1.0.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/elements": "^2.9.40",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.21.0",
    "@sentry/react-native": "~8.28.0",
    "@typedigital/telemetrydeck-react": "^0.5.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-media-library": "~58.0.13",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-share-intent": "^8.0.1",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.25",
    "htmlparser2": "12.0.0",
    "lucide-react-native": "^1.62.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-android-widget": "^0.25.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "text-encoding": "^0.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "~14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/text-encoding": "^0.0.40",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-doctor": "^1.21.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "~1.3.1",
    "typescript": "~6.0.3"
  },
  "//overrides": "Temporary: overrides.expo-share-intent maps 8.0.1 (declares SDK 57) onto SDK 58 expo, expo-constants, expo-linking and @expo/config-plugins; remove per #2357 (upstream achorein/expo-share-intent#240)",
  "overrides": {
    "react-test-renderer": "19.3.0",
    "react-dom": "19.3.0",
    "image-size": "1.2.1",
    "source-map-js": "1.2.2",
    "shell-quote": "1.11.0",
    "expo-share-intent": {
      "expo": "$expo",
      "expo-constants": "$expo-constants",
      "expo-linking": "$expo-linking",
      "@expo/config-plugins": "~58.0.9"
    },
    "expo-modules-core": "58.0.24"
  }
}
