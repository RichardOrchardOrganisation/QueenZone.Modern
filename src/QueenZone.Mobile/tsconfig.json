{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "node_modules",
    "scripts",
    "contracts",
    "jest.setup.ts",
    "jest.config.js",
    "babel.config.js",
    "src/test",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
