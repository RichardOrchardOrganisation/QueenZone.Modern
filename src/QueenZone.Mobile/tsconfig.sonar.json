{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "customConditions": ["react-native"],
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "contracts/**/*", "scripts/**/*", "jest.setup.ts"],
  "exclude": ["node_modules", "coverage", "ios", "android"]
}
