{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test",
    "jest.setup.ts",
    "contracts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "ios",
    "android",
    "coverage",
    "*.mjs"
  ]
}
