@page "/account/crosswords"
@model MyCrosswordsModel
<section class="qz-section"><div class="qz-container"><p><a href="/account/settings">Account settings</a></p><h1>My crosswords</h1>
<p>@Model.History.TotalCompleted completed · @Model.History.WeeklyStreak consecutive weeks</p><p>Weeks start Monday at midnight UTC. Your streak remains active while the current week is still in progress.</p>
@if (Model.History.Items.Count == 0) { <p>No completed crosswords yet. <a href="/crosswords">Find a crossword</a>.</p> }
else { <ul>@foreach (var puzzle in Model.History.Items) { <li>
@if (puzzle.Playable) { <a href="/crosswords/@puzzle.Slug">@puzzle.Title</a> } else { <span>@puzzle.Title — currently unavailable</span> }
— @TimeSpan.FromSeconds(puzzle.ElapsedSeconds).ToString(@"h\:mm\:ss") · @(puzzle.Clean ? "Clean solve ✓" : "Assisted solve") · @puzzle.CompletedAt.ToString("u")
</li> }</ul> }
</div></section>
