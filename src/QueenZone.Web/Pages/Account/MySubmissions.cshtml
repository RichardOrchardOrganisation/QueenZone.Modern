@page "/account/my-submissions"
@model MySubmissionsModel
@using QueenZone.Data
@using QueenZone.Storage

<partial name="_PageHero" model='@(("Members", "My submissions", "Track photos, news suggestions, articles, trivia facts, quiz questions, and fan performances you have submitted.", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose">
    <p>
      <a href="/submit/photo">Submit a photo</a>
      ·
      <a href="/submit/news">Suggest news</a>
      ·
      <a href="/submit/article">Write an article</a>
      ·
      <a href="/submit/trivia">Suggest trivia</a>
      ·
      <a href="/submit/quiz-question">Suggest a quiz question</a>
      ·
      <a href="/submit/fan-performance">Submit a performance</a>
      ·
      <a href="/account/settings">Account settings</a>
    </p>

    <div asp-validation-summary="ModelOnly" class="qz-account-notice qz-account-notice--error"></div>

    <nav class="qz-submissions-tabs" aria-label="Submission types">
      <a class="qz-submissions-tabs__tab @(Model.ActiveTab == MySubmissionsModel.TabPhotos ? "is-active" : null)"
         href="@Model.GetTabHref(MySubmissionsModel.TabPhotos)"
         aria-current="@(Model.ActiveTab == MySubmissionsModel.TabPhotos ? "page" : null)">Photos</a>
      <a class="qz-submissions-tabs__tab @(Model.ActiveTab == MySubmissionsModel.TabNews ? "is-active" : null)"
         href="@Model.GetTabHref(MySubmissionsModel.TabNews)"
         aria-current="@(Model.ActiveTab == MySubmissionsModel.TabNews ? "page" : null)">News suggestions</a>
      <a class="qz-submissions-tabs__tab @(Model.ActiveTab == MySubmissionsModel.TabArticles ? "is-active" : null)"
         href="@Model.GetTabHref(MySubmissionsModel.TabArticles)"
         aria-current="@(Model.ActiveTab == MySubmissionsModel.TabArticles ? "page" : null)">Articles</a>
      <a class="qz-submissions-tabs__tab @(Model.ActiveTab == MySubmissionsModel.TabTrivia ? "is-active" : null)"
         href="@Model.GetTabHref(MySubmissionsModel.TabTrivia)"
         aria-current="@(Model.ActiveTab == MySubmissionsModel.TabTrivia ? "page" : null)">Trivia</a>
      <a class="qz-submissions-tabs__tab @(Model.ActiveTab == MySubmissionsModel.TabQuiz ? "is-active" : null)"
         href="@Model.GetTabHref(MySubmissionsModel.TabQuiz)"
         aria-current="@(Model.ActiveTab == MySubmissionsModel.TabQuiz ? "page" : null)">Quiz</a>
      <a class="qz-submissions-tabs__tab @(Model.ActiveTab == MySubmissionsModel.TabPerformances ? "is-active" : null)"
         href="@Model.GetTabHref(MySubmissionsModel.TabPerformances)"
         aria-current="@(Model.ActiveTab == MySubmissionsModel.TabPerformances ? "page" : null)">Fan performances</a>
    </nav>

    @if (Model.ActiveTab == MySubmissionsModel.TabPhotos)
    {
      <h2 class="visually-hidden">Photos</h2>
      @if (Model.PhotoSubmissions.Count == 0)
      {
        <p>You have not submitted any photos yet. <a href="/submit/photo">Submit a photo</a></p>
      }
      else
      {
        <table class="admin-table">
          <thead>
            <tr>
              <th></th>
              <th>Title</th>
              <th>Status</th>
              <th>Submitted</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model.PhotoSubmissions)
            {
              var thumbUrl = UgcProxyPaths.GetPath(BlobUploadContainers.Photos, item.ThumbnailBlobPath);
              <tr>
                <td>
                  <img class="qz-submissions-thumb" src="@thumbUrl" alt="" width="64" height="64" />
                </td>
                <td>@item.Title</td>
                <td><partial name="_SubmissionStatusBadge" model="item.Status" /></td>
                <td>@item.SubmittedAt.ToString("u")</td>
                <td>
                  @if (item.Status == PhotoSubmissionStatus.Rejected
                       && !string.IsNullOrWhiteSpace(item.RejectionReason))
                  {
                    <span>@item.RejectionReason</span>
                  }
                  else if (!string.IsNullOrWhiteSpace(item.ReviewNotes))
                  {
                    <span>@item.ReviewNotes</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    }
    else if (Model.ActiveTab == MySubmissionsModel.TabPerformances)
    {
      <h2 class="visually-hidden">Fan performances</h2>
      @if (Model.FanPerformanceSubmissions.Count == 0)
      {
        <p>You have not submitted any fan performances yet. <a href="/submit/fan-performance">Submit a performance</a></p>
      }
      else
      {
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Status</th>
              <th>Submitted</th>
              <th>Notes</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model.FanPerformanceSubmissions)
            {
              var memberNotes = FanPerformanceSubmissionFeedback.GetMemberFacingNotes(item);
              var publishedPath = FanPerformanceSubmissionFeedback.GetPublishedPath(item);
              <tr>
                <td>
                  @item.Title
                  <div class="qz-submissions-secondary">@item.CoveredSong · @item.PerformedBy</div>
                </td>
                <td><partial name="_SubmissionStatusBadge" model="item.Status" /></td>
                <td>@item.SubmittedAt.ToString("u")</td>
                <td>
                  @if (memberNotes is not null)
                  {
                    <span>@memberNotes</span>
                  }
                </td>
                <td>
                  @if (publishedPath is not null)
                  {
                    <a href="@publishedPath">View live performance</a>
                  }
                  @if (FanPerformanceSubmissionWorkflow.CanMemberWithdraw(item.Status))
                  {
                    <form method="post" asp-page-handler="WithdrawFanPerformance" class="qz-account-form">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="id" value="@item.Id" />
                      <button type="submit" class="qz-button">Withdraw</button>
                    </form>
                  }
                  @if (FanPerformanceSubmissionWorkflow.CanMemberReplyNeedsInfo(item.Status))
                  {
                    <form method="post" asp-page-handler="ReplyFanPerformance" class="qz-account-form">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="id" value="@item.Id" />
                      <label class="qz-account-form__field">
                        <span>Reply</span>
                        <textarea name="reply" rows="2" maxlength="@FanPerformanceSubmissionService.MaxReplyLength" required></textarea>
                      </label>
                      <button type="submit" class="qz-button">Send reply</button>
                    </form>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    }
    else if (Model.ActiveTab == MySubmissionsModel.TabTrivia)
    {
      <h2 class="visually-hidden">Trivia</h2>
      @if (Model.TriviaSubmissions.Count == 0)
      {
        <p>You have not suggested any trivia facts yet. <a href="/submit/trivia">Suggest a trivia fact</a></p>
      }
      else
      {
        <table class="admin-table">
          <thead>
            <tr>
              <th>Fact</th>
              <th>Status</th>
              <th>Submitted</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model.TriviaSubmissions)
            {
              <tr>
                <td>@item.Text</td>
                <td><partial name="_SubmissionStatusBadge" model="item.Status" /></td>
                <td>@item.SubmittedAt.ToString("u")</td>
                <td>
                  @if (item.Status == TriviaFactSubmissionStatus.Rejected
                       && !string.IsNullOrWhiteSpace(item.RejectionReason))
                  {
                    <span>@item.RejectionReason</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    }
    else if (Model.ActiveTab == MySubmissionsModel.TabQuiz)
    {
      <h2 class="visually-hidden">Quiz</h2>
      @if (Model.QuizSubmissions.Count == 0)
      {
        <p>You have not suggested any quiz questions yet. <a href="/submit/quiz-question">Suggest a quiz question</a></p>
      }
      else
      {
        <table class="admin-table">
          <thead>
            <tr>
              <th>Question</th>
              <th>Status</th>
              <th>Submitted</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model.QuizSubmissions)
            {
              <tr>
                <td>@item.QuestionText</td>
                <td><partial name="_SubmissionStatusBadge" model="item.Status" /></td>
                <td>@item.SubmittedAt.ToString("u")</td>
                <td>
                  @if (item.Status == QuizQuestionSubmissionStatus.Rejected
                       && !string.IsNullOrWhiteSpace(item.RejectionReason))
                  {
                    <span>@item.RejectionReason</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    }
    else if (Model.ActiveTab == MySubmissionsModel.TabNews)
    {
      <h2 class="visually-hidden">News suggestions</h2>
      @if (Model.NewsSuggestions.Count == 0)
      {
        <p>You have not suggested any news yet. <a href="/submit/news">Suggest a news link</a></p>
      }
      else
      {
        <table class="admin-table">
          <thead>
            <tr>
              <th>URL</th>
              <th>Status</th>
              <th>Submitted</th>
              <th>Notes</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var row in Model.NewsSuggestions)
            {
              var item = row.Suggestion;
              <tr>
                <td>
                  <a href="@item.Url" rel="noopener noreferrer" title="@item.Url">
                    @SubmissionStatusPresentation.TruncateUrl(item.Url)
                  </a>
                  @if (!string.IsNullOrWhiteSpace(item.Title))
                  {
                    <div class="qz-submissions-secondary">@item.Title</div>
                  }
                </td>
                <td><partial name="_SubmissionStatusBadge" model="item.Status" /></td>
                <td>@item.SubmittedAt.ToString("u")</td>
                <td>@item.ReviewNotes</td>
                <td>
                  @if (!string.IsNullOrWhiteSpace(row.PublishedArticlePath))
                  {
                    <a href="@row.PublishedArticlePath">View article</a>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    }
    else
    {
      <h2 class="visually-hidden">Articles</h2>
      @if (Model.ArticleSubmissions.Count == 0)
      {
        <p>You have not submitted any articles yet. <a href="/submit/article">Write your first article</a></p>
      }
      else
      {
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Status</th>
              <th>Submitted</th>
              <th>Notes</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in Model.ArticleSubmissions)
            {
              <tr>
                <td>@item.Title</td>
                <td><partial name="_SubmissionStatusBadge" model="item.Status" /></td>
                <td>@(item.SubmittedAt?.ToString("u") ?? "Draft")</td>
                <td>
                  @if (item.Status == ArticleSubmissionStatus.RequiresRevision
                       && !string.IsNullOrWhiteSpace(item.ReviewNotes))
                  {
                    <p class="qz-submissions-revision-note">@item.ReviewNotes</p>
                  }
                  else if (!string.IsNullOrWhiteSpace(item.RejectionReason))
                  {
                    <span>@item.RejectionReason</span>
                  }
                  else if (!string.IsNullOrWhiteSpace(item.ReviewNotes))
                  {
                    <span>@item.ReviewNotes</span>
                  }
                </td>
                <td>
                  @if (item.Status == ArticleSubmissionStatus.Draft)
                  {
                    <a href="@Model.GetArticleEditPath(item.Id)">Continue editing</a>
                  }
                  else if (item.Status == ArticleSubmissionStatus.RequiresRevision)
                  {
                    <a href="@Model.GetArticleEditPath(item.Id)">Revise and resubmit</a>
                  }
                  else if (item.Status == ArticleSubmissionStatus.Published)
                  {
                    <a href="@ArticlesRoutes.GetCommunityArticleDetailPath(item.Slug)">View published article</a>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    }

    <partial name="_ArchivePagination" model="Model.Pagination" />
  </div>
</section>
