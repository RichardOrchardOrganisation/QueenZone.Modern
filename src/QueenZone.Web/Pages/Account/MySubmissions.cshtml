@page "/account/my-submissions"
@model MySubmissionsModel
@using QueenZone.Data
@using QueenZone.Storage

<partial name="_PageHero" model='@(("Members", "My submissions", "Track photos, news suggestions, articles, trivia facts, quiz questions, and fan performances you have submitted.", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose">
    <p>
      <a href="/submit/photo">Submit a photo</a>
      ·
      <a href="/submit/news">Suggest news</a>
      ·
      <a href="/submit/article">Write an article</a>
      ·
      <a href="/submit/trivia">Suggest trivia</a>
      ·
      <a href="/submit/quiz-question">Suggest a quiz question</a>
      ·
      <a href="/submit/fan-performance">Submit a performance</a>
      ·
      <a href="/account/settings">Account settings</a>
    </p>

    <div asp-validation-summary="ModelOnly" class="qz-account-notice qz-account-notice--error"></div>

    <partial name="_MySubmissionTabs" model="Model.Tabs" />

    <partial name="@Model.ActiveSectionPartial" model="Model" />

    <partial name="_ArchivePagination" model="Model.Pagination" />
  </div>
</section>
