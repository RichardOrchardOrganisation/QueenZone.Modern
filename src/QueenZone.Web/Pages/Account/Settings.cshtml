@page "/account/settings"
@model SettingsModel

<partial name="_PageHero" model='@(("Members", "Account settings", "Update the name shown on your posts and contributions.", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
      <p class="qz-account-notice qz-account-notice--success" role="status">@Model.StatusMessage</p>
    }

    <p>
      <a href="/account/my-submissions">My submissions</a>
      ·
      <a href="/following">Following</a>
      ·
      <a href="/submit/photo">Submit a photo</a>
    </p>

    <div class="qz-account-settings">
      <dl class="qz-account-settings__meta">
        <div>
          <dt>Email</dt>
          <dd>@Model.Email</dd>
        </div>
        <div>
          <dt>Linked sign-in providers</dt>
          <dd>
            @if (Model.LinkedProviders.Count == 0)
            {
              <span>None linked</span>
            }
            else
            {
              <ul class="qz-account-settings__providers">
                @foreach (var provider in Model.LinkedProviders)
                {
                  <li>@provider</li>
                }
              </ul>
            }
          </dd>
        </div>
      </dl>

      <section class="qz-account-settings__legacy" aria-labelledby="legacy-heading">
        <h2 id="legacy-heading" class="qz-account-settings__section-title">Legacy forum account</h2>
        @if (Model.LegacyLink.Kind == LegacyAccountLinkKind.Linked && Model.LegacyLink.Match is not null)
        {
          <p class="qz-account-settings__legacy-status" role="status">
            Linked to legacy forum account
            <strong>@Model.LegacyLink.Match.Username</strong>
            <span class="qz-meta">(id @Model.LegacyLink.Match.UserId)</span>.
          </p>
          <p class="qz-meta">
            Unlink if this is the wrong classic account. You can then claim another match for your email,
            if one is free.
          </p>
          <form method="post"
                asp-page-handler="UnlinkLegacy"
                class="qz-account-form"
                data-busy-submit
                data-busy-label="Unlinking…">
            @Html.AntiForgeryToken()
            <div class="qz-account-form__actions">
              <button type="submit" class="qz-button qz-button--outline">Unlink legacy account</button>
            </div>
            <p class="qz-account-form__status" data-busy-status hidden role="status" aria-live="polite"></p>
          </form>
        }
        else if (Model.LegacyLink.Kind == LegacyAccountLinkKind.Claimable && Model.LegacyLink.ClaimableMatches.Count > 0)
        {
          @if (Model.LegacyLink.HasMultipleClaimable)
          {
            <p>
              We found multiple classic QueenZone forum accounts matching your email.
              Choose which one to claim so your modern membership connects to the right archive history.
            </p>
          }
          else
          {
            var sole = Model.LegacyLink.ClaimableMatches[0];
            <p>
              We found a classic QueenZone forum account matching your email:
              <strong>@sole.Username</strong>.
              Claim it to connect your modern membership with your archive history.
            </p>
          }
          <form method="post"
                asp-page-handler="ClaimLegacy"
                class="qz-account-form"
                data-busy-submit
                data-busy-label="Claiming…">
            @Html.AntiForgeryToken()
            @if (Model.LegacyLink.HasMultipleClaimable)
            {
              <fieldset class="qz-account-form__legacy-choices">
                <legend class="qz-account-form__legend">Legacy accounts for your email</legend>
                @foreach (var option in Model.LegacyLink.ClaimableMatches)
                {
                  var optionId = $"legacy-option-{option.UserId}";
                  var isSelected = Model.SelectedLegacyUserId == option.UserId
                      || (Model.SelectedLegacyUserId is null
                          && option.UserId == Model.LegacyLink.ClaimableMatches[0].UserId);
                  <label class="qz-account-form__radio" for="@optionId">
                    <input id="@optionId"
                           type="radio"
                           name="SelectedLegacyUserId"
                           value="@option.UserId"
                           @(isSelected ? "checked" : null) />
                    <span>
                      <strong>@option.Username</strong>
                      <span class="qz-meta">(id @option.UserId)</span>
                    </span>
                  </label>
                }
              </fieldset>
              <span asp-validation-for="SelectedLegacyUserId" class="qz-account-form__field-error"></span>
            }
            else
            {
              <input type="hidden" name="SelectedLegacyUserId" value="@Model.LegacyLink.ClaimableMatches[0].UserId" />
            }
            <label class="qz-account-form__checkbox">
              <input asp-for="AdoptLegacyDisplayName" type="checkbox" />
              @if (Model.LegacyLink.HasMultipleClaimable)
              {
                <span>Use the selected legacy username as my display name</span>
              }
              else
              {
                <span>Use legacy username <strong>@Model.LegacyLink.ClaimableMatches[0].Username</strong> as my display name</span>
              }
            </label>
            <div class="qz-account-form__actions">
              <button type="submit" class="qz-button">Claim legacy account</button>
            </div>
            <p class="qz-account-form__status" data-busy-status hidden role="status" aria-live="polite"></p>
          </form>
          @if (Model.LegacyLink.UnavailableMatches.Count > 0)
          {
            <p class="qz-account-settings__legacy-status qz-meta">
              Also matching this email but already linked to another modern member:
              @string.Join(", ", Model.LegacyLink.UnavailableMatches.Select(m => $"{m.Username} (id {m.UserId})")).
            </p>
          }
        }
        else if (Model.LegacyLink.Kind == LegacyAccountLinkKind.Unavailable && Model.LegacyLink.UnavailableMatches.Count > 0)
        {
          @if (Model.LegacyLink.UnavailableMatches.Count == 1)
          {
            var taken = Model.LegacyLink.UnavailableMatches[0];
            <p class="qz-account-settings__legacy-status">
              A legacy account for <strong>@taken.Username</strong> matches your email,
              but it is already linked to another modern member.
            </p>
          }
          else
          {
            <p class="qz-account-settings__legacy-status">
              Legacy accounts matching your email are already linked to other modern members:
              @string.Join(", ", Model.LegacyLink.UnavailableMatches.Select(m => $"{m.Username} (id {m.UserId})")).
            </p>
          }
        }
        else
        {
          <p class="qz-account-settings__legacy-status qz-meta">
            No legacy forum account is linked to this email.
          </p>
        }
      </section>

      <section class="qz-account-settings__avatar" aria-labelledby="avatar-heading">
        <h2 id="avatar-heading" class="qz-account-settings__section-title">Profile avatar</h2>
        <div class="qz-account-settings__avatar-row">
          <partial name="_MemberAvatar" model="@(new MemberAvatarViewModel { DisplayName = Model.DisplayName, MemberId = Model.MemberId, HasAvatar = Model.HasAvatar, Size = "md" })" />
          <div class="qz-account-settings__avatar-forms">
            <form method="post"
                  asp-page-handler="UploadAvatar"
                  enctype="multipart/form-data"
                  class="qz-account-form"
                  data-busy-submit
                  data-busy-label="Uploading…">
              @Html.AntiForgeryToken()
              <label class="qz-account-form__field">
                <span>Upload image</span>
                <input asp-for="AvatarFile"
                       type="file"
                       accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                       required />
                <span asp-validation-for="AvatarFile" class="qz-account-form__field-error"></span>
                <span class="qz-account-form__help">
                  JPEG, PNG, or WebP. Max 2&nbsp;MB. Cropped to a square and stored as WebP.
                </span>
              </label>
              <div class="qz-account-form__actions">
                <button type="submit" class="qz-button">Upload avatar</button>
              </div>
              <p class="qz-account-form__status" data-busy-status hidden role="status" aria-live="polite"></p>
            </form>
            @if (Model.HasAvatar)
            {
              <form method="post"
                    asp-page-handler="RemoveAvatar"
                    class="qz-account-form"
                    data-busy-submit
                    data-busy-label="Removing…">
                @Html.AntiForgeryToken()
                <div class="qz-account-form__actions">
                  <button type="submit" class="qz-button qz-button--outline">Remove avatar</button>
                </div>
                <p class="qz-account-form__status" data-busy-status hidden role="status" aria-live="polite"></p>
              </form>
            }
          </div>
        </div>
      </section>

      <form method="post"
            class="qz-account-form"
            novalidate
            data-busy-submit
            data-busy-label="Saving…">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="qz-account-form__errors" role="alert"></div>

        <label class="qz-account-form__field">
          <span>Display name</span>
          <input asp-for="DisplayName"
                 type="text"
                 maxlength="@MemberAccountService.MaxDisplayNameLength"
                 minlength="@MemberAccountService.MinDisplayNameLength"
                 required
                 autocomplete="nickname"
                 aria-describedby="display-name-help" />
          <span asp-validation-for="DisplayName" class="qz-account-form__field-error"></span>
          <span id="display-name-help" class="qz-account-form__help">
            2–100 characters. This name appears on forum posts, photo attributions, and other contributions. Display names do not need to be unique.
          </span>
        </label>

        <div class="qz-account-form__actions">
          <button type="submit" class="qz-button">Save display name</button>
        </div>
        <p class="qz-account-form__status" data-busy-status hidden role="status" aria-live="polite"></p>
      </form>

      <section class="qz-account-settings__legacy" aria-labelledby="social-profiles-heading">
        <h2 id="social-profiles-heading" class="qz-account-settings__section-title">Social profiles</h2>
        <p>
          Add a handle or https profile URL for the networks you use. Empty fields stay hidden
          on your public profile. Only these six networks are accepted.
        </p>
        <form method="post"
              asp-page-handler="UpdateSocialLinks"
              class="qz-account-form"
              novalidate
              data-busy-submit
              data-busy-label="Saving…">
          @Html.AntiForgeryToken()
          <div asp-validation-summary="ModelOnly" class="qz-account-form__errors" role="alert"></div>
          <label class="qz-account-form__field">
            <span>X</span>
            <input asp-for="SocialX"
                   type="text"
                   maxlength="@MemberSocialLinkUrl.MaxInputLength"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="@@queen or https://x.com/queen" />
            <span asp-validation-for="SocialX" class="qz-account-form__field-error"></span>
          </label>
          <label class="qz-account-form__field">
            <span>Instagram</span>
            <input asp-for="SocialInstagram"
                   type="text"
                   maxlength="@MemberSocialLinkUrl.MaxInputLength"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="@@queen or https://www.instagram.com/queen" />
            <span asp-validation-for="SocialInstagram" class="qz-account-form__field-error"></span>
          </label>
          <label class="qz-account-form__field">
            <span>Facebook</span>
            <input asp-for="SocialFacebook"
                   type="text"
                   maxlength="@MemberSocialLinkUrl.MaxInputLength"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="queen or https://www.facebook.com/queen" />
            <span asp-validation-for="SocialFacebook" class="qz-account-form__field-error"></span>
          </label>
          <label class="qz-account-form__field">
            <span>YouTube</span>
            <input asp-for="SocialYouTube"
                   type="text"
                   maxlength="@MemberSocialLinkUrl.MaxInputLength"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="@@QueenOfficial or https://www.youtube.com/@@QueenOfficial" />
            <span asp-validation-for="SocialYouTube" class="qz-account-form__field-error"></span>
          </label>
          <label class="qz-account-form__field">
            <span>TikTok</span>
            <input asp-for="SocialTikTok"
                   type="text"
                   maxlength="@MemberSocialLinkUrl.MaxInputLength"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="@@queen or https://www.tiktok.com/@@queen" />
            <span asp-validation-for="SocialTikTok" class="qz-account-form__field-error"></span>
          </label>
          <label class="qz-account-form__field">
            <span>Bluesky</span>
            <input asp-for="SocialBluesky"
                   type="text"
                   maxlength="@MemberSocialLinkUrl.MaxInputLength"
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="name.bsky.social or https://bsky.app/profile/name.bsky.social" />
            <span asp-validation-for="SocialBluesky" class="qz-account-form__field-error"></span>
          </label>
          <div class="qz-account-form__actions">
            <button type="submit" class="qz-button">Save social profiles</button>
          </div>
          <p class="qz-account-form__status" data-busy-status hidden role="status" aria-live="polite"></p>
        </form>
      </section>

      <section class="qz-account-settings__legacy" aria-labelledby="message-privacy-heading">
        <h2 id="message-privacy-heading" class="qz-account-settings__section-title">Who can message me</h2>
        <p>
          This controls who may start a new private conversation. Replies in existing conversations
          still work unless you block that member. Follow members from their profile to use the
          “people I follow” option and to see their public contributions on
          <a href="/following">Following</a>.
        </p>
        <form method="post"
              asp-page-handler="UpdateMessagePrivacy"
              class="qz-account-form"
              data-busy-submit
              data-busy-label="Saving…">
          @Html.AntiForgeryToken()
          <fieldset class="qz-account-form__legacy-choices">
            <legend class="qz-account-form__legend">Who may start a new conversation</legend>
            <label class="qz-account-form__radio">
              <input asp-for="MessagePrivacy" type="radio" value="@MemberMessagePrivacy.Members" />
              <span>Signed-in members</span>
            </label>
            <label class="qz-account-form__radio">
              <input asp-for="MessagePrivacy" type="radio" value="@MemberMessagePrivacy.Followed" />
              <span>People I follow</span>
            </label>
            <label class="qz-account-form__radio">
              <input asp-for="MessagePrivacy" type="radio" value="@MemberMessagePrivacy.Nobody" />
              <span>Nobody</span>
            </label>
          </fieldset>
          <div class="qz-account-form__actions">
            <button type="submit" class="qz-button">Save messaging privacy</button>
          </div>
          <p class="qz-account-form__status" data-busy-status hidden role="status" aria-live="polite"></p>
        </form>
      </section>

      <section class="qz-account-settings__legacy" aria-labelledby="delete-account-heading">
        <h2 id="delete-account-heading" class="qz-account-settings__section-title">Delete account</h2>
        @if (Model.ScheduledDeletionAt is not null)
        {
          <p>
            Deletion is scheduled for <strong>@Model.ScheduledDeletionAt.Value.ToString("d MMMM yyyy")</strong>.
            Your public identity is anonymised until then, but you can still change your mind.
          </p>
          <a class="qz-button" href="/account/delete">Review or cancel deletion</a>
        }
        else
        {
          <p>Delete your account, sign-in details, avatar, and modern contributions.</p>
          <a class="qz-button qz-button--danger" href="/account/delete">Delete my account</a>
        }
      </section>
    </div>
  </div>
</section>
