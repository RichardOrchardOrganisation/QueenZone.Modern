@page "/admin/fan-performance-reports/{id:guid}"
@model QueenZone.Web.Pages.Admin.FanPerformanceReports.DetailModel
@using QueenZone.Data
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
  var report = Model.Report!;
  var token = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken;
}

<div class="admin-shell">
  <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  <h1>Fan performance report</h1>

  @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
  {
    <output class="qz-status-block qz-account-notice @(Model.StatusMessageKind == "error" ? "qz-account-notice--error" : "qz-account-notice--success")">
      @Model.StatusMessage
    </output>
  }

  <dl class="admin-detail-list">
    <dt>Performance</dt>
    <dd>
      @(string.IsNullOrWhiteSpace(report.TitleSnapshot) ? $"#{report.StageId}" : report.TitleSnapshot)
      @if (!string.IsNullOrWhiteSpace(report.PerformedBySnapshot))
      {
        <span> · @report.PerformedBySnapshot</span>
      }
      <span> · stage @report.StageId · <a href="@FanPerformanceRoutes.GetPublicPath(report.StageId)">Public page</a></span>
    </dd>
    <dt>Reporter</dt>
    <dd>
      @report.ReporterDisplayName
      · <a href="/admin/members/@report.ReporterMemberId">Member account</a>
    </dd>
    <dt>Reason</dt>
    <dd>@report.Reason</dd>
    <dt>Status</dt>
    <dd><partial name="_SubmissionStatusBadge" model="report.Status" /></dd>
    <dt>Reported at</dt>
    <dd>@report.CreatedAt.ToString("u")</dd>
    @if (!string.IsNullOrWhiteSpace(report.ReviewedBy))
    {
      <dt>Reviewed</dt>
      <dd>@report.ReviewedBy @report.ReviewedAt?.ToString("u")</dd>
    }
  </dl>

  @if (FanPerformanceReportStatus.IsOpen(report.Status))
  {
    <section>
      <h2>Actions</h2>
      <form method="post" action="/admin/fan-performance-reports/@report.Id/hide" class="admin-inline-form">
        <input type="hidden" name="@AdminFanPerformanceReportsPageModel.AntiforgeryTokenFieldName" value="@token" />
        <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Hide and resolve", "Hide this published performance?", Detail: "The performance is hidden from the public site and the report is marked resolved.", TriggerClass: "qz-button"))" />
      </form>
      <form method="post" action="/admin/fan-performance-reports/@report.Id/dismiss" class="admin-inline-form">
        <input type="hidden" name="@AdminFanPerformanceReportsPageModel.AntiforgeryTokenFieldName" value="@token" />
        <button type="submit" class="qz-button qz-button--outline">Dismiss without hiding</button>
      </form>
    </section>
  }
</div>
