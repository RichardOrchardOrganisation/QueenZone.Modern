@page "/admin/forum-reports/{id:guid}"
@model QueenZone.Web.Pages.Admin.ForumReports.DetailModel
@using QueenZone.Data

@{ var report = Model.Report!; }
<div class="admin-shell">
  <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  <h1>Reported forum post</h1>
  @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
  { <p class="qz-account-notice" role="status">@Model.StatusMessage</p> }
  <dl class="admin-detail-list">
    <dt>Author</dt><dd>@report.AuthorDisplayNameSnapshot @if (report.ReportedMemberId is Guid memberId) { <a href="/admin/members/@memberId">Member account</a> }</dd>
    <dt>Reporter</dt><dd>@(Model.Reporter?.DisplayName ?? "Unknown member") @if (Model.Reporter is not null) { <a href="/admin/members/@report.ReporterMemberId">Member account</a> }</dd>
    <dt>Reason</dt><dd>@report.Category</dd>
    <dt>Details</dt><dd>@(string.IsNullOrWhiteSpace(report.Details) ? "—" : report.Details)</dd>
    <dt>Status</dt><dd><partial name="_SubmissionStatusBadge" model="report.Status" /></dd>
    <dt>Current post state</dt><dd>@(Model.CurrentPost is null ? "Hidden or removed" : "Visible")</dd>
    <dt>Current member state</dt><dd>@(Model.ReportedMember is null ? "No active member account" : Model.ReportedMember.IsSuspended ? "Suspended" : "Active")</dd>
    <dt>Reported at</dt><dd>@report.CreatedAt.ToString("u")</dd>
    <dt>Previous reports involving author</dt><dd>@report.PreviousAuthorReportCount</dd>
  </dl>
  <section>
    <h2>Evidence snapshot</h2>
    <p><strong>@report.ThreadTitleSnapshot</strong> · post @report.PostId · @report.PostCreatedAtSnapshot.ToString("u")</p>
    <blockquote>@report.PostBodySnapshot</blockquote>
    @if (report.Context.Count > 0)
    {
      <h3>Preceding context</h3>
      <ul>@foreach (var item in report.Context) { <li><strong>@item.AuthorDisplayName</strong> (@item.PostedAt.ToString("u")): @item.Body</li> }</ul>
    }
    @if (Model.CurrentPost is not null)
    {
      <p><a href="@(ForumRoutes.GetTopicCanonicalPath(report.TopicId, report.ThreadTitleSnapshot))#post-@report.PostId">Open current post and moderation controls</a></p>
    }
  </section>
  <section>
    <h2>Update status</h2>
    <form method="post" action="/admin/forum-reports/@report.Id/status" class="admin-inline-form">
      @Html.AntiForgeryToken()
      <label>Status <select name="status">@foreach (var status in PrivateMessageReportStatus.All) { if (report.Status == status) { <option value="@status" selected>@status</option> } else { <option value="@status">@status</option> } }</select></label>
      <button type="submit">Save</button>
    </form>
  </section>
</div>
