@page "/admin/help/{id:guid}"
@model QueenZone.Web.Pages.Admin.HelpRequests.DetailModel
@using QueenZone.Data
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
  var request = Model.Item!;
  var token = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken;
}

<div class="admin-shell" data-testid="admin-help-requests-detail">
  <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  <h1>@request.Subject</h1>

  @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
  {
    <output class="qz-status-block qz-account-notice @(Model.StatusMessageKind == "error" ? "qz-account-notice--error" : "qz-account-notice--success")">
      @Model.StatusMessage
    </output>
  }

  <dl class="admin-detail-list">
    <dt>Topic</dt>
    <dd>@HelpRequestTopic.DisplayName(request.Topic)</dd>
    <dt>From</dt>
    <dd>
      @request.Name
      &lt;<a href="mailto:@request.Email">@request.Email</a>&gt;
      @if (request.MemberId is Guid memberId)
      {
        <span> · <a href="/admin/members/@memberId">Member account</a></span>
      }
      else
      {
        <span> · Guest</span>
      }
    </dd>
    <dt>Status</dt>
    <dd><partial name="_SubmissionStatusBadge" model="request.Status" /></dd>
    <dt>Submitted</dt>
    <dd>@request.SubmittedAt.ToString("u")</dd>
    <dt>Reviewed</dt>
    <dd>@(request.ReviewedAt?.ToString("u") ?? "—")</dd>
    <dt>Reviewer</dt>
    <dd>@(request.ReviewerEmail ?? "—")</dd>
    <dt>Internal notes</dt>
    <dd>@(string.IsNullOrWhiteSpace(request.ReviewNotes) ? "—" : request.ReviewNotes)</dd>
    <dt>Message</dt>
    <dd style="white-space: pre-wrap;">@request.Message</dd>
  </dl>

  <section data-testid="admin-help-reply-log">
    <h2>Replies sent</h2>
    @if (Model.Replies.Count == 0)
    {
      <p>No reply has been emailed for this request yet.</p>
    }
    else
    {
      @foreach (var reply in Model.Replies)
      {
        <article class="admin-detail-list">
          <p><strong>@reply.Subject</strong></p>
          <p>
            Sent @reply.SentAt.ToString("u") by @reply.SentByEmail to @reply.ToEmail
          </p>
          <p style="white-space: pre-wrap;">@reply.Body</p>
        </article>
      }
    }
  </section>

  <section>
    <h2>Reply by email</h2>
    <p>Sends to <strong>@request.Email</strong> from Queenzone Support and adds the message to the log above.</p>
    <form method="post" action="/admin/help/@request.Id/reply" data-testid="admin-help-reply-form">
      <input type="hidden" name="@AdminHelpRequestsPageModel.AntiforgeryTokenFieldName" value="@token" />
      <p>
        <label>
          Subject
          <input name="replySubject" maxlength="@HelpRequestReply.MaxSubjectLength" value="@Model.ReplySubject" required />
        </label>
      </p>
      <p>
        <label>
          Message
          <textarea name="replyBody" rows="10" maxlength="@HelpRequestReply.MaxBodyLength" required>@Model.ReplyBody</textarea>
        </label>
      </p>
      <p>
        <label>
          <input type="checkbox" name="markResolved" value="true" checked />
          Mark as resolved after sending
        </label>
      </p>
      <button type="submit">Send reply</button>
    </form>
  </section>

  <section>
    <h2>Update status</h2>
    <form method="post" action="/admin/help/@request.Id/status" class="admin-inline-form">
      <input type="hidden" name="@AdminHelpRequestsPageModel.AntiforgeryTokenFieldName" value="@token" />
      <label>
        Status
        <select name="status">
          @foreach (var status in HelpRequestStatus.All)
          {
            @if (request.Status == status)
            {
              <option value="@status" selected>@HelpRequestStatus.DisplayName(status)</option>
            }
            else
            {
              <option value="@status">@HelpRequestStatus.DisplayName(status)</option>
            }
          }
        </select>
      </label>
      <label>
        Internal notes
        <input name="reviewNotes" maxlength="500" value="@request.ReviewNotes" />
      </label>
      <button type="submit">Save</button>
    </form>
  </section>
</div>
