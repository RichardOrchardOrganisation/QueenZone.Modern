@page "/admin/members"
@model IndexModel

<div class="admin-shell">
  <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  <h1>Members</h1>

  <form method="get" class="admin-search-form">
    <label class="visually-hidden" for="member-search">Search by display name or email</label>
    <input id="member-search" type="search" name="query" value="@Model.Query" placeholder="Search by display name or email" />
    <button type="submit" class="qz-button">Search</button>
  </form>

  @if (Model.NoAccountAuthor is not null)
  {
    var hideConfirmMessage = System.Text.Json.JsonSerializer.Serialize(
      $"Hide all posts and threads started by {Model.NoAccountAuthor.DisplayName}? Other people's posts stay.");
    <section class="admin-form">
      <h2>@Model.NoAccountAuthor.DisplayName</h2>
      <p>No member account. <strong>@Model.NoAccountAuthor.PostCount</strong> posts and <strong>@Model.NoAccountAuthor.ThreadCount</strong> started threads match this exact display name.</p>
      @if (Model.NoAccountAuthor.IsHidden)
      {
        <form method="post" action="/admin/members/forum-author/Unhide">
          @Html.AntiForgeryToken()
          <input type="hidden" name="DisplayName" value="@Model.NoAccountAuthor.DisplayName" />
          <button type="submit" class="qz-button">Unhide all posts and threads</button>
        </form>
      }
      else
      {
        <form method="post" action="/admin/members/forum-author/Hide" onsubmit="return confirm(@hideConfirmMessage);">
          @Html.AntiForgeryToken()
          <input type="hidden" name="DisplayName" value="@Model.NoAccountAuthor.DisplayName" />
          <button type="submit" class="qz-button qz-button--danger">Hide all posts and threads</button>
        </form>
      }
    </section>
  }
  else if (Model.Members.Count == 0)
  {
    <p>No members found.</p>
  }
  else
  {
    <table class="admin-table">
      <thead>
        <tr>
          <th>Display name</th>
          <th>Email</th>
          <th>Joined</th>
          <th>Last login</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var member in Model.Members)
        {
          <tr>
            <td>@member.DisplayName</td>
            <td>@member.Email</td>
            <td>@member.CreatedAt.ToString("u")</td>
            <td>@(member.LastLoginAt?.ToString("u") ?? "Never")</td>
            <td>
              @if (member.IsSuspended)
              {
                <span class="admin-status admin-status--error">Suspended</span>
              }
              else
              {
                <span>Active</span>
              }
            </td>
            <td><a href="/admin/members/@member.Id">Review</a></td>
          </tr>
        }
      </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
      <nav class="admin-pagination" aria-label="Member pages">
        @if (Model.PageNumber > 1)
        {
          <a href="/admin/members?query=@Model.Query&pageNumber=@(Model.PageNumber - 1)">Previous</a>
        }
        <span>Page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total)</span>
        @if (Model.PageNumber < Model.TotalPages)
        {
          <a href="/admin/members?query=@Model.Query&pageNumber=@(Model.PageNumber + 1)">Next</a>
        }
      </nav>
    }
  }
</div>
