@page "/admin/news/{id:int}/preview"
@model PreviewModel

@if (Model.Article is not null && Model.Item is not null)
{
  <div class="admin-shell">
  <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  <p class="admin-preview-banner">Preview mode. @(Model.Article.IsPublished ? "This article is published." : "This article is not published.")</p>
  <p class="article-nav"><a href="/admin/news/@Model.Article.Id/edit">Edit</a></p>

  @if (Model.DiscoveryProvenance is not null)
  {
    <partial name="_DiscoveryProvenance" model="Model.DiscoveryProvenance" />
  }

  <h1>@Model.Item.Title</h1>
  <p class="date"><time datetime="@Model.Item.PublishedAt.ToString("yyyy-MM-dd")">@Model.Item.PublishedAt.ToString("dd MMMM yyyy")</time></p>
  @{
    var previewImageUrl = NewsArticleImage.ResolveDisplayUrl(Model.Item.ImageBlobKey, Model.Item.ImageGalleryPicId);
    var hasArticleImage = NewsArticleImage.HasResolvedImage(Model.Item.ImageBlobKey, Model.Item.ImageGalleryPicId);
    var previewAlt = hasArticleImage ? Model.Item.Title : "";
  }
  <figure class="admin-article-image">
    <img src="@previewImageUrl" alt="@previewAlt" width="600" height="400">
  </figure>

  <p class="lede">@Model.Item.Excerpt</p>
  <article class="article-body">@Html.Raw(NewsArticleContent.FormatBody(Model.Item.Body))</article>

  @if (NewsArticleContent.IsSafePublicUrl(Model.Item.SourceUrl))
  {
    <p class="article-source">Source: <a href="@Model.Item.SourceUrl" rel="noopener noreferrer">@Model.Item.SourceUrl</a></p>
  }

  @if (!Model.Article.IsPublished)
  {
    <p><em>This draft is hidden from the public archive.</em></p>
  }
  </div>
}
