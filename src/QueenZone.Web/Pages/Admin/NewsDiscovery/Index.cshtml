@page "/admin/news-discovery"
@model IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<div class="admin-shell">
  <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  <h1>News discovery review</h1>
  <p>
    <a href="/admin/news-discovery/prompt-settings">Editorial guidance</a>
  </p>

  @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
  {
    <p class="admin-status admin-status--@(Model.StatusMessageKind ?? "info")">@Model.StatusMessage</p>
  }

  <section class="admin-panel">
    <h2>News gathering</h2>
    <p>
      Queue source gathering and AI triage on the local Windows runner. Drafts are generated only when you select an individual candidate or explicitly request a draft for a submitted URL.
    </p>
    @if (Model.RunnerHeartbeat is null)
    {
      <p class="admin-muted">The local runner has not checked in yet.</p>
    }
    else
    {
      <p class="admin-muted">
        Runner <strong>@Model.RunnerHeartbeat.RunnerId</strong> was last seen
        @Model.RunnerHeartbeat.LastSeenAtUtc.ToString("dd MMM yyyy HH:mm") UTC
        (@(Model.RunnerRecentlySeen ? "online recently" : "not seen recently")).
      </p>
    }
    <form method="post" action="/admin/news-discovery?handler=queuerun" class="admin-inline-form">
      <input type="hidden" name="@AdminNewsDiscoveryPageModel.AntiforgeryTokenFieldName" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken">
      <button type="submit">Queue news gathering</button>
    </form>

    <h3>Submit article URL</h3>
    <p class="admin-muted">
      Force triage for a public article URL outside the normal source polling cycle.
      Outbound fetch runs on the local Windows runner. Default is triage only; draft generation requires an explicit choice.
    </p>
    <form method="post" action="/admin/news-discovery?handler=queueurlingestion" class="admin-filter-form">
      <input type="hidden" name="@AdminNewsDiscoveryPageModel.AntiforgeryTokenFieldName" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken">
      <div class="admin-filter-grid">
        <label>
          Article URL
          <input type="url" name="ArticleUrl" value="@Model.ArticleUrl" required placeholder="https://example.com/queen-story" maxlength="2000" />
        </label>
        <fieldset>
          <legend>Action</legend>
          <label>
            <input type="radio" name="UrlIngestionAction" value="triage" checked="@(Model.UrlIngestionAction != "triage-and-draft")" />
            Force triage
          </label>
          <label>
            <input type="radio" name="UrlIngestionAction" value="triage-and-draft" checked="@(Model.UrlIngestionAction == "triage-and-draft")" />
            Force triage and generate AI draft
          </label>
        </fieldset>
      </div>
      <button type="submit">Queue URL ingestion</button>
    </form>

    @if (Model.RecentRuns.Count > 0)
    {
      <details>
        <summary>Recent runner requests (@Model.RecentRuns.Count)</summary>
        <p class="admin-muted">
          These are processing-history records, not news articles. Completed test probes remain here for audit purposes and disappear as newer requests replace them.
        </p>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Requested</th>
              <th>Kind</th>
              <th>Status</th>
              <th>Requested by</th>
              <th>URL / notes</th>
              <th>Runner</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var run in Model.RecentRuns)
            {
              <tr>
                <td>@run.RequestedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</td>
                <td>@run.Kind@(run.GenerateDraft ? " + draft" : "")</td>
                <td>@run.Status</td>
                <td>@run.RequestedBy</td>
                <td>@(run.ArticleUrl ?? "Scheduled gathering")</td>
                <td>@(run.RunnerId ?? "—")</td>
                <td>@(run.Summary ?? run.ErrorMessage ?? "—")</td>
              </tr>
            }
          </tbody>
        </table>
      </details>
    }
  </section>

  <form method="get" class="admin-filter-form">
    <div class="admin-filter-grid">
      <label>
        Status
        <select name="status">
          <option value="">Active</option>
          @foreach (var status in Enum.GetValues<QueenZone.Data.NewsCandidateStatus>())
          {
            <option value="@status" selected="@(Model.Status == status)">@NewsDiscoveryStatusLabels.Format(status)</option>
          }
        </select>
      </label>
      <label>
        Source
        <select name="sourceId">
          <option value="">All</option>
          @foreach (var source in Model.Sources)
          {
            <option value="@source.Id" selected="@(Model.SourceId == source.Id)">@source.DisplayName</option>
          }
        </select>
      </label>
      <label>
        Trust tier
        <select name="trustTier">
          <option value="">All</option>
          @foreach (var tier in Enum.GetValues<QueenZone.Data.NewsDiscoveryTrustTier>())
          {
            <option value="@tier" selected="@(Model.TrustTier == tier)">@NewsDiscoveryStatusLabels.FormatTrustTier(tier)</option>
          }
        </select>
      </label>
      <label>
        Min confidence
        <input type="number" name="minConfidence" min="0" max="1" step="0.05" value="@Model.MinConfidence" />
      </label>
      <label>
        Entity
        <input type="text" name="entity" value="@Model.Entity" placeholder="e.g. Brian May" />
      </label>
      <label>
        Discovered from
        <input type="date" name="discoveredFrom" value="@(Model.DiscoveredFrom?.ToString("yyyy-MM-dd"))" />
      </label>
      <label>
        Discovered to
        <input type="date" name="discoveredTo" value="@(Model.DiscoveredTo?.ToString("yyyy-MM-dd"))" />
      </label>
      <label>
        Has draft
        <select name="hasDraft">
          <option value="">Any</option>
          <option value="true" selected="@(Model.HasDraft == true)">Yes</option>
          <option value="false" selected="@(Model.HasDraft == false)">No</option>
        </select>
      </label>
    </div>
    <button type="submit">Apply filters</button>
  </form>

  @if (Model.Candidates.Count == 0)
  {
    <p>No candidates match the current filters.</p>
  }
  else
  {
    <p class="admin-muted">Showing @Model.RangeStart–@Model.RangeEnd of @Model.TotalCount candidates.</p>

    <form method="post" action="/admin/news-discovery?handler=ignorelisted" class="admin-inline-form">
      <input type="hidden" name="@AdminNewsDiscoveryPageModel.AntiforgeryTokenFieldName" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken">
      @if (Model.CurrentPage > 1)
      {
        <input type="hidden" name="page" value="@Model.CurrentPage">
      }
      @if (Model.PageSize != AdminNewsDiscoveryRoutes.ListPageSize)
      {
        <input type="hidden" name="pageSize" value="@Model.PageSize">
      }
      @if (Model.Status is not null)
      {
        <input type="hidden" name="status" value="@Model.Status">
      }
      @if (Model.SourceId is not null)
      {
        <input type="hidden" name="sourceId" value="@Model.SourceId">
      }
      @if (Model.TrustTier is not null)
      {
        <input type="hidden" name="trustTier" value="@Model.TrustTier">
      }
      @if (Model.MinConfidence is not null)
      {
        <input type="hidden" name="minConfidence" value="@Model.MinConfidence">
      }
      @if (!string.IsNullOrWhiteSpace(Model.Entity))
      {
        <input type="hidden" name="entity" value="@Model.Entity">
      }
      @if (Model.DiscoveredFrom is not null)
      {
        <input type="hidden" name="discoveredFrom" value="@(Model.DiscoveredFrom?.ToString("yyyy-MM-dd"))">
      }
      @if (Model.DiscoveredTo is not null)
      {
        <input type="hidden" name="discoveredTo" value="@(Model.DiscoveredTo?.ToString("yyyy-MM-dd"))">
      }
      @if (Model.HasDraft is not null)
      {
        <input type="hidden" name="hasDraft" value="@(Model.HasDraft.Value ? "true" : "false")">
      }
      <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Ignore this page / remove from queue", "Ignore all candidates shown on this page?", ConfirmLabel: "Ignore all", IsDanger: false))" />
    </form>

    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Source</th>
          <th>Status</th>
          <th>Scores</th>
          <th>Discovered</th>
          <th>Draft</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var candidate in Model.Candidates)
        {
          <tr>
            <td>
              <a href="@candidate.SourceUrl" rel="noopener noreferrer" target="_blank">@candidate.SourceTitle</a>
            </td>
            <td>
              @candidate.SourceDisplayName
              <span class="admin-muted">(@NewsDiscoveryStatusLabels.FormatTrustTier(candidate.SourceTrustTier))</span>
            </td>
            <td>@NewsDiscoveryStatusLabels.Format(candidate.Status)</td>
            <td>
              @if (candidate.RelevanceScore is not null || candidate.ConfidenceScore is not null)
              {
                <span>R @(candidate.RelevanceScore?.ToString("0.00") ?? "—")</span>
                <span>C @(candidate.ConfidenceScore?.ToString("0.00") ?? "—")</span>
              }
              else
              {
                <span>—</span>
              }
            </td>
            <td>@candidate.DiscoveredAt.ToString("dd MMM yyyy HH:mm") UTC</td>
            <td>@(candidate.DraftTitle ?? "—")</td>
            <td class="admin-actions">
              <a href="/admin/news-discovery/@candidate.Id">Review</a>
              @if (QueenZone.Data.NewsCandidateWorkflow.CanReject(candidate.Status))
              {
                <form method="post" action="/admin/news-discovery?handler=ignore" class="admin-inline-form">
                  <input type="hidden" name="@AdminNewsDiscoveryPageModel.AntiforgeryTokenFieldName" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken">
                  <input type="hidden" name="id" value="@candidate.Id">
                  @if (Model.CurrentPage > 1)
                  {
                    <input type="hidden" name="page" value="@Model.CurrentPage">
                  }
                  @if (Model.PageSize != AdminNewsDiscoveryRoutes.ListPageSize)
                  {
                    <input type="hidden" name="pageSize" value="@Model.PageSize">
                  }
                  @if (Model.Status is not null)
                  {
                    <input type="hidden" name="status" value="@Model.Status">
                  }
                  @if (Model.SourceId is not null)
                  {
                    <input type="hidden" name="sourceId" value="@Model.SourceId">
                  }
                  @if (Model.TrustTier is not null)
                  {
                    <input type="hidden" name="trustTier" value="@Model.TrustTier">
                  }
                  @if (Model.MinConfidence is not null)
                  {
                    <input type="hidden" name="minConfidence" value="@Model.MinConfidence">
                  }
                  @if (!string.IsNullOrWhiteSpace(Model.Entity))
                  {
                    <input type="hidden" name="entity" value="@Model.Entity">
                  }
                  @if (Model.DiscoveredFrom is not null)
                  {
                    <input type="hidden" name="discoveredFrom" value="@(Model.DiscoveredFrom?.ToString("yyyy-MM-dd"))">
                  }
                  @if (Model.DiscoveredTo is not null)
                  {
                    <input type="hidden" name="discoveredTo" value="@(Model.DiscoveredTo?.ToString("yyyy-MM-dd"))">
                  }
                  @if (Model.HasDraft is not null)
                  {
                    <input type="hidden" name="hasDraft" value="@(Model.HasDraft.Value ? "true" : "false")">
                  }
                  <button type="submit">Ignore / remove from queue</button>
                </form>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>

    <partial name="_ArchivePagination" model="Model.Pagination" />
  }
</div>
