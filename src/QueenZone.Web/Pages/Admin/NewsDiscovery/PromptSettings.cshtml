@page "/admin/news-discovery/prompt-settings"
@model PromptSettingsModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken ?? string.Empty;
}
<div class="admin-shell">
  <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  <h1>News agent editorial guidance</h1>

  <p class="admin-status admin-status--info">
    The text below is the editorial guidance used by future NewsAgent runs only. Publishing does not rewrite existing candidates, AI results, or drafts.
    The worker may take up to 60 seconds to pick up a published change. It starts pre-filled with the built-in default &mdash; edit it freely and save to fully replace that default.
    The JSON output format, evidence, quotation, media-link, and safety rules always stay fixed in code and are added automatically; they cannot be changed here.
  </p>

  @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
  {
    <p class="admin-status admin-status--@(Model.StatusMessageKind ?? "info")">@Model.StatusMessage</p>
  }

  @if (Model.Errors.Count > 0)
  {
    <ul class="admin-errors">
      @foreach (var error in Model.Errors)
      {
        <li>@error</li>
      }
    </ul>
  }

  @foreach (var guidance in new[] { Model.Triage, Model.Draft })
  {
    <section class="admin-panel" id="guidance-@guidance.TypeKey">
      <h2>@(guidance.Type == QueenZone.Data.NewsAgentGuidanceType.Triage ? "Triage guidance" : "Draft guidance")</h2>
      <p class="admin-muted">@guidance.PublishedSummary</p>
      <p>
        Using compiled default:
        <strong>@(guidance.UsingCompiledDefault ? "yes" : "no")</strong>
      </p>
      @if (guidance.Published is not null)
      {
        <p class="admin-muted">
          Published hash @guidance.Published.ContentHash
          @(string.IsNullOrWhiteSpace(guidance.Published.Content) ? "(empty overlay)" : string.Empty)
        </p>
      }

      <form method="post" action="/admin/news-discovery/prompt-settings?handler=SaveDraft" class="admin-form">
        <input type="hidden" name="@AdminNewsDiscoveryPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken" />
        <input type="hidden" name="type" value="@guidance.Type" />
        <input type="hidden" name="rowVersion" value="@guidance.DraftRowVersion" />
        <label>
          Editorial guidance (plain text, max 4000 characters). Pre-filled with the built-in default &mdash; edit and save to replace it.
          <textarea name="content" rows="8" maxlength="4000">@guidance.DraftContent</textarea>
        </label>
        <button type="submit">Save draft</button>
      </form>

      <form method="post" action="/admin/news-discovery/prompt-settings?handler=Publish" class="admin-inline-form">
        <input type="hidden" name="@AdminNewsDiscoveryPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken" />
        <input type="hidden" name="type" value="@guidance.Type" />
        <input type="hidden" name="rowVersion" value="@guidance.DraftRowVersion" />
        <label>
          <input type="checkbox" name="confirm" value="true" />
          Confirm publish
        </label>
        @if (guidance.Draft is null)
        {
          <button type="button" disabled>Publish draft</button>
        }
        else
        {
          <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Publish draft", "Publish this draft?", "Future runs will use it. Existing candidates stay unchanged.", IsDanger: false))" />
        }
      </form>

      <form method="post" action="/admin/news-discovery/prompt-settings?handler=RestoreDefault" class="admin-inline-form">
        <input type="hidden" name="@AdminNewsDiscoveryPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken" />
        <input type="hidden" name="type" value="@guidance.Type" />
        <label>
          <input type="checkbox" name="confirm" value="true" />
          Confirm restore compiled default
        </label>
        <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Restore compiled default", "Restore the compiled default?", Detail: "This publishes an empty overlay. History is kept.", IsDanger: false))" />
      </form>

      <details>
        <summary>Composed preview (fixed rules plus editorial guidance)</summary>
        <p class="admin-muted">
          Read-only preview of the exact system prompt the worker will send. The fixed JSON/safety rules above are
          not editable here. Your saved guidance (or the built-in default, if nothing is published) is placed after
          them, between
          --- BEGIN ADMIN EDITORIAL GUIDANCE (untrusted) ---
          and
          --- END ADMIN EDITORIAL GUIDANCE ---.
        </p>
        <pre class="admin-review-pre">@guidance.ComposedPreview</pre>
      </details>

      @if (guidance.Draft is not null)
      {
        <details>
          <summary>Diff versus published</summary>
          @if (guidance.Diff.Count == 0)
          {
            <p class="admin-muted">No published text to compare, or both sides are empty.</p>
          }
          else
          {
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Change</th>
                  <th>Published</th>
                  <th>Draft</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var line in guidance.Diff)
                {
                  <tr>
                    <td>@line.Kind</td>
                    <td><pre class="admin-review-pre">@(line.PublishedLine ?? string.Empty)</pre></td>
                    <td><pre class="admin-review-pre">@(line.DraftLine ?? string.Empty)</pre></td>
                  </tr>
                }
              </tbody>
            </table>
          }
        </details>
      }

      <details>
        <summary>Revision history</summary>
        @if (guidance.History.Count == 0)
        {
          <p class="admin-muted">No revisions yet. The compiled default is in use.</p>
        }
        else
        {
          <table class="admin-table">
            <thead>
              <tr>
                <th>Revision</th>
                <th>Status</th>
                <th>Hash</th>
                <th>Created</th>
                <th>Published</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              @foreach (var revision in guidance.History)
              {
                <tr>
                  <td>@revision.RevisionNumber</td>
                  <td>@revision.Status</td>
                  <td>@revision.ContentHash</td>
                  <td>@revision.CreatedByEmail @revision.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</td>
                  <td>
                    @(revision.PublishedByEmail ?? "—")
                    @(revision.PublishedAt?.ToString("dd MMM yyyy HH:mm") is string publishedAt ? publishedAt + " UTC" : string.Empty)
                  </td>
                  <td>
                    @if (revision.Status != QueenZone.Data.NewsAgentGuidanceStatus.Draft)
                    {
                      <form method="post" action="/admin/news-discovery/prompt-settings?handler=Rollback" class="admin-inline-form">
                        <input type="hidden" name="@AdminNewsDiscoveryPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken" />
                        <input type="hidden" name="type" value="@guidance.Type" />
                        <input type="hidden" name="revisionId" value="@revision.Id" />
                        <label>
                          <input type="checkbox" name="confirm" value="true" />
                          Confirm rollback
                        </label>
                        <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Rollback", $"Publish a new revision copied from revision {revision.RevisionNumber}?", "History is kept.", IsDanger: false))" />
                      </form>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        }
      </details>
    </section>
  }
</div>
