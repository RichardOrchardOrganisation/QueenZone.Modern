@page "/admin/news-discovery/{id:int}"
@model ReviewModel

<div class="admin-shell">
<partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
@if (Model.Candidate is null)
{
  <p>Candidate not found.</p>
}
else
{
  <h1>Review candidate #@Model.Candidate.Id</h1>

  @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
  {
    <p class="admin-status admin-status--@(Model.StatusMessageKind ?? "info")">@Model.StatusMessage</p>
  }

  <partial name="_ReviewSource" model="Model" />

  <partial name="_ReviewTriage" model="Model" />

  <partial name="_ReviewEvidence" model="Model" />

  <partial name="_ReviewQuotes" model="Model" />

  <partial name="_ReviewDraft" model="Model" />

  <partial name="_ReviewProvenance" model="Model" />

  <partial name="_ReviewActions" model="Model" />

}
</div>
