@page "/admin/photo-corrections"
@model IndexModel
@using QueenZone.Data

<div class="admin-shell" data-testid="admin-photocorrections-index">
  <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  <h1>Photo corrections</h1>
  <p>
    Member proposals about existing archive photographs, oldest first.
    <a href="/admin/photos">Photos</a>
  </p>

  <nav aria-label="Review queue">
    <a href="/admin/photo-corrections" aria-current="@(Model.ShowMemories ? null : "page")">Corrections</a>
    ·
    <a href="/admin/photo-corrections?queue=memories" aria-current="@(Model.ShowMemories ? "page" : null)">Fan memories</a>
  </nav>

  @if (Model.Proposals.Count == 0)
  {
    <p>@(Model.ShowMemories ? "No fan memories awaiting review." : "No photo corrections awaiting review.")</p>
  }
  else
  {
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">Photo</th>
          <th scope="col">Change</th>
          <th scope="col">Proposed</th>
          <th scope="col">Submitter</th>
          <th scope="col">Submitted</th>
          <th scope="col">Status</th>
          <th scope="col"><span class="visually-hidden">Review</span></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var item in Model.Proposals)
        {
          <tr>
            <td><a href="/admin/photos/@item.PicId">#@item.PicId</a></td>
            <td>@PhotoCorrectionKind.Label(item.Kind)</td>
            <td>@item.ProposedValue</td>
            <td>@item.SubmitterDisplayName</td>
            <td>@item.SubmittedAt.ToString("u")</td>
            <td><partial name="_SubmissionStatusBadge" model="item.Status" /></td>
            <td><a href="/admin/photo-corrections/@item.Id">Review</a></td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>
