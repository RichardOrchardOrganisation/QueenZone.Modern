@model DetailModel

<dl>
  <dt>Photo</dt>
  <dd><a href="/admin/photos/@Model.Proposal!.PicId">#@Model.Proposal.PicId</a> — @Model.PhotoSummary</dd>
  <dt>Change</dt>
  <dd>@Model.KindLabel</dd>
  <dt>Value the member saw</dt>
  <dd>@DetailModel.Show(Model.Proposal.CurrentValue)</dd>
  <dt>Proposed value</dt>
  <dd>@Model.Proposal.ProposedValue</dd>
  <dt>Explanation</dt>
  <dd>@Model.Proposal.Explanation</dd>
  <dt>Confidence</dt>
  <dd>@Model.Proposal.Confidence</dd>
  <dt>Evidence type</dt>
  <dd>@DetailModel.Show(Model.Proposal.EvidenceType)</dd>
  <dt>Evidence link</dt>
  <dd>@* Plain text on purpose: editors copy it rather than click a member-supplied link. *@@DetailModel.Show(Model.Proposal.EvidenceUrl)</dd>
  <dt>Requested public credit</dt>
  <dd>@Model.CreditLabel</dd>
  <dt>Submitter</dt>
  <dd>@(Model.Proposal.SubmitterDisplayName ?? "Unknown")</dd>
  <dt>Status</dt>
  <dd>@Model.Proposal.Status</dd>
  <dt>Submitted</dt>
  <dd>@Model.Proposal.SubmittedAt.ToString("u")</dd>
  <dt>Member's reply</dt>
  <dd>@DetailModel.Show(Model.Proposal.MemberReply)</dd>
  <dt>Message to member</dt>
  <dd>@DetailModel.Show(Model.Proposal.MessageToMember)</dd>
  <dt>Internal review notes</dt>
  <dd>@DetailModel.Show(Model.Proposal.ReviewNotes)</dd>
  <dt>Previous value (restored on revert)</dt>
  <dd>@DetailModel.Show(Model.Proposal.AppliedFromValue)</dd>
</dl>
