@page "/admin/photos/{id:int}"
@model EditModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
  var photo = Model.Photo!;
}

<div class="admin-shell">
  <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  <div class="admin-form-panel">
    <h1>Edit photo #@photo.PicId</h1>
    @if (photo.IsVisible)
    {
      <p>
        <a href="/photography/@photo.CategorySlug/@photo.PicId" target="_blank" rel="noopener">View public page</a>
      </p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
      <output class="qz-status-block qz-account-notice qz-account-notice--@(Model.StatusMessageKind == "error" ? "error" : "success")">
        @Model.StatusMessage
      </output>
    }

    <figure class="admin-photo-preview">
      <a href="@photo.ImageUrl" target="_blank" rel="noopener">
        <img src="@photo.ImageUrl" alt="@photo.Title" />
      </a>
      <figcaption class="admin-photo-preview__meta">
        @if (photo.PictureWidth > 0 && photo.PictureHeight > 0)
        {
          <text>Full image: @photo.PictureWidth &times; @photo.PictureHeight</text>
        }
        else
        {
          <text>Full image dimensions unavailable</text>
        }
        @if (photo.ThumbWidth > 0 && photo.ThumbHeight > 0)
        {
          <text> · Thumbnail: @photo.ThumbWidth &times; @photo.ThumbHeight</text>
        }
      </figcaption>
    </figure>

    <form class="admin-form" method="post" action="/admin/photos/@photo.PicId/save" enctype="multipart/form-data">
      <input type="hidden" name="@AdminPhotosPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken" />
      <input type="hidden" name="expectedTitle" value="@photo.Title" />
      <input type="hidden" name="expectedKeywords" value="@photo.Keywords" />
      <input type="hidden" name="expectedYear" value="@photo.Year" />
      <input type="hidden" name="expectedDateTime" value="@photo.DateTime.ToString("o")" />
      <input type="hidden" name="expectedCatId" value="@photo.CatId" />
      <input type="hidden" name="expectedIsVisible" value="@(photo.IsVisible ? "true" : "false")" />

      <label>
        Title
        <input type="text" name="title" value="@photo.Title" required maxlength="200" />
      </label>

      <label>
        Category
        <select name="catId" required>
          @foreach (var category in Model.Categories)
          {
            if (category.CatId == photo.CatId)
            {
              <option value="@category.CatId" selected>@category.Name</option>
            }
            else
            {
              <option value="@category.CatId">@category.Name</option>
            }
          }
        </select>
      </label>

      <label>
        Year
        <input type="number" name="year" value="@photo.Year" />
      </label>

      <label>
        Date
        <input type="datetime-local" name="dateTime" value="@photo.DateTime.ToString("yyyy-MM-ddTHH:mm")" />
      </label>

      <label>
        Keywords
        <input type="text" name="keywords" value="@photo.Keywords" maxlength="500" />
      </label>

      <label>
        Replace image file (optional)
        <input type="file" name="replaceFile" accept="image/jpeg,image/png,image/webp,image/tiff" />
      </label>

      <button type="submit">Save changes</button>
    </form>

    <hr />

    <form method="post" action="/admin/photos/@photo.PicId/@(photo.IsVisible ? "hide" : "show")" class="qz-inline-form">
      <input type="hidden" name="@AdminPhotosPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken" />
      <button type="submit">@(photo.IsVisible ? "Hide from gallery" : "Show in gallery")</button>
    </form>

    <form method="post" action="/admin/photos/@photo.PicId/regeneratethumb" class="qz-inline-form qz-inline-form--spaced">
      <input type="hidden" name="@AdminPhotosPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken" />
      <button type="submit">Regenerate WebP thumbnail</button>
    </form>

    <form method="post" action="/admin/photos/@photo.PicId/delete" class="qz-inline-form qz-inline-form--spaced">
      <input type="hidden" name="@AdminPhotosPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken" />
      <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Hard delete", "Hard-delete this photo?", Detail: "The photo and its gallery blobs (original + thumbnail) are permanently removed. Prefer Hide for soft removal."))" />
    </form>
  </div>
</div>
