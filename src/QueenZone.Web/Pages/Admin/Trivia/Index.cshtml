@page "/admin/trivia"
@model IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<div class="admin-shell">
<partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
@if (Model.CreateForm is not null)
{
  ViewData["AntiforgeryToken"] = antiforgeryToken;
  <partial name="_TriviaForm" model="Model.CreateForm" />
}
else
{
  <h1>Trivia</h1>

  @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
  {
    <p class="admin-status admin-status--@Model.StatusMessageKind">@Model.StatusMessage</p>
  }

  <p>
    <a href="/admin/trivia/new">Add trivia fact</a>
  </p>

  <form method="get" action="/admin/trivia" class="admin-form">
    <label>
      Filter by category
      <input type="text" name="category" value="@Model.CategoryFilter" list="trivia-categories" maxlength="@TriviaValidation.MaxCategoryLength">
    </label>
    <datalist id="trivia-categories">
      @foreach (var category in Model.Categories)
      {
        <option value="@category"></option>
      }
    </datalist>
    <div class="admin-form-actions">
      <button type="submit">Filter</button>
      @if (!string.IsNullOrWhiteSpace(Model.CategoryFilter))
      {
        <a href="/admin/trivia">Clear</a>
      }
    </div>
  </form>

  <partial name="_ArchivePagination" model="Model.Pagination" />

  @if (Model.Facts.Count == 0)
  {
    <p>@(string.IsNullOrWhiteSpace(Model.CategoryFilter) ? "No trivia facts yet." : "No trivia facts match that category.")</p>
  }
  else
  {
    <table class="admin-table">
      <thead>
        <tr>
          <th>Fact</th>
          <th>Category</th>
          <th>Difficulty</th>
          <th>Added</th>
          <th>Published</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var fact in Model.Facts)
        {
          <tr>
            <td class="admin-title-cell">@fact.Text</td>
            <td>@(fact.Category ?? "—")</td>
            <td>@(fact.Difficulty ?? "—")</td>
            <td>@fact.CreatedAt.ToString("dd MMMM yyyy")</td>
            <td>@(fact.IsPublished ? "Yes" : "No")</td>
            <td class="admin-actions">
              <a href="/admin/trivia/@fact.Id/edit">Edit</a>
              <form method="post" action="/admin/trivia?handler=TogglePublish" style="display:inline">
                <input type="hidden" name="@AdminTriviaPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken">
                <input type="hidden" name="id" value="@fact.Id">
                <input type="hidden" name="isPublished" value="@fact.IsPublished">
                <input type="hidden" name="PageNumber" value="@Model.PageNumber">
                <input type="hidden" name="category" value="@Model.CategoryFilter">
                <button type="submit">@(fact.IsPublished ? "Unpublish" : "Publish")</button>
              </form>
              <form method="post" action="/admin/trivia?handler=Delete" style="display:inline">
                <input type="hidden" name="@AdminTriviaPageModel.AntiforgeryTokenFieldName" value="@antiforgeryToken">
                <input type="hidden" name="id" value="@fact.Id">
                <input type="hidden" name="PageNumber" value="@Model.PageNumber">
                <input type="hidden" name="category" value="@Model.CategoryFilter">
                <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Delete", "Delete this trivia fact?", Detail: "This cannot be undone."))" />
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>

    <partial name="_ArchivePagination" model="Model.Pagination" />
  }
}
</div>
