@page "/articles/{id:int}/{slug}"
@model DetailModel

@section Head {
  @if (!string.IsNullOrWhiteSpace(Model.StructuredDataJson))
  {
    <script type="application/ld+json" nonce="@HttpContext.GetCspNonce()">@Html.Raw(Model.StructuredDataJson)</script>
  }
}

@if (Model.Item is not null)
{
  <partial name="_ArticleHeader" model="Model.Header" />

  <div class="qz-reading">
    @if (!string.IsNullOrWhiteSpace(Model.Item.Excerpt))
    {
      <p class="lede">@Model.Item.Excerpt</p>
    }
    <article class="article-body">@Html.Raw(ArticleContent.FormatBody(Model.Item.Body))</article>

    @if (!string.IsNullOrWhiteSpace(Model.Item.Source))
    {
      if (NewsArticleContent.IsSafePublicUrl(Model.Item.Source))
      {
        <p class="article-source"><a href="@Model.Item.Source" rel="noopener noreferrer">Source</a></p>
      }
      else
      {
        <p class="article-source">@Model.Item.Source</p>
      }
    }

    @if (!string.IsNullOrWhiteSpace(Model.Item.Tags))
    {
      <div class="qz-article-tags">
        @foreach (var tag in Model.Item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
          <a href="/articles?tag=@Uri.EscapeDataString(tag)" class="qz-tag">@tag</a>
        }
      </div>
    }

    <partial name="_SocialShare" />
  </div>
}