@page "/crosswords/{slug}"
@model CrosswordPlayModel
@using System.Text.Json
@{
  var puzzle = Model.Puzzle;
  Layout = Model.OfflineShell ? "_CrosswordOfflineLayout" : "_Layout";
}
@section Head {
  <link rel="stylesheet" href="~/css/crossword.css" asp-append-version="true" />
}
<partial name="_CrosswordPlayer" model="new QueenZone.Web.Pages.Crosswords.CrosswordPlayerViewModel(Model.Puzzle, Model.MemberId, Model.OfflineShell)" />
@section Scripts {
  <script type="module" src="~/js/crossword-play.js" asp-append-version="true"></script>
}
