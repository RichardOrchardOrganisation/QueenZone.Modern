@page "/discography"
@model IndexModel

<partial name="_PageHero" model='@(("The Queenzone.com Archive", "Discography", "The core catalogue.", $"{Model.Albums.Count} studio albums"))' />

<section class="qz-section">
  <div class="qz-container">
    <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
    <a class="qz-callout" href="@DiscographyRoutes.GetRareDiscographyPath()">
      <div class="qz-callout__eyebrow">From the notice board</div>
      <div class="qz-callout__title">Rare Discography — the John S Stuart collection</div>
      <p class="qz-callout__body">
        The most staggering, amazing Queen discography ever made publicly available — rare
        recordings and analysis painstakingly documented by John S Stuart, the "Indiana Jones"
        of Queen recordings, whose knowledge is unparalleled in the Queen fan community.
      </p>
    </a>
    @if (Model.Albums.Count == 0)
    {
      <p>No albums are available yet.</p>
    }
    else
    {
      <div class="qz-album-grid">
        @foreach (var album in Model.Albums)
        {
          <a class="qz-album-card" href="@DiscographyRoutes.GetAlbumPath(album)">
            <div class="qz-album-card__cover">
              @if (album.ThumbnailUrl is not null)
              {
                <img src="@album.ThumbnailUrl" alt="" loading="lazy">
              }
            </div>
            <div class="qz-album-card__title">@album.Name</div>
            @if (album.ReleaseYear is int year)
            {
              <div class="qz-album-card__year">@year</div>
            }
          </a>
        }
      </div>
    }
  </div>
</section>
