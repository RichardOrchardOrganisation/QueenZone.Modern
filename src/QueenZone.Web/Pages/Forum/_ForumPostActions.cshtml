@model ForumPostPresentation
@{ var post = Model.Post; }
        @if (Model.ShowActions)
        {
          <div class="qz-forum-post__actions">
            @if (Model.CanReply)
            {
              <a class="qz-forum-post__quote-link" href="#Body" data-qz-quote-trigger>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-3 2s-1 2 1 2z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v2z"></path></svg>
                Quote
              </a>
            }
            @if (Model.CanEdit)
            {
              <a class="qz-forum-post__edit-link" href="/forum/post/@post.Id/edit">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path><path d="m15 5 4 4"></path></svg>
                Edit
              </a>
            }
            @if (Model.MessageHref is not null)
            {
              <a class="qz-forum-post__message-link" href="@Model.MessageHref" aria-label="Message @post.AuthorUsername" title="Message @post.AuthorUsername">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 5h16v11H8l-4 3V5Z" />
                  <path d="m7 9 5 3 5-3" />
                </svg>
                <span class="visually-hidden">Message @post.AuthorUsername</span>
              </a>
            }
            <partial name="_ForumPostReporting" model="Model" />
            @if (Model.IsAdmin)
            {
              <a class="qz-forum-post__hide-author-link" href="/forum/post/@post.Id/hide-author" aria-label="Hide all posts by @post.AuthorUsername" title="Hide all posts by @post.AuthorUsername">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="m17 11 4 4m0-4-4 4" />
                </svg>
                <span class="visually-hidden">Hide all posts by @post.AuthorUsername</span>
              </a>
            }
          </div>
        }
