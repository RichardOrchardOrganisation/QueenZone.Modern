@model IReadOnlyList<ForumPostViewModel>
@inject UgcHtml UgcHtml
@{
  var canReply = ViewData["CanReply"] as bool? ?? false;
  var isAdmin = ViewData["IsAdmin"] as bool? ?? false;
  var returnPath = $"{Context.Request.Path}{Context.Request.QueryString}";
}
@if (Model.Count == 0)
{
  <p>No posts are available in this thread yet.</p>
}
else
{
  if (Model.Any(post => ForumVideoContent.Project(post.Body, UgcHtml).YoutubeVideos.Count > 0))
  {
    <p class="qz-meta" data-testid="forum-video-privacy">Videos near where you're reading load automatically from YouTube (privacy-enhanced mode) before you press Play. Loading a player connects to YouTube and shares your IP address and this site's address.</p>
  }
  <div class="qz-forum-posts">
    @foreach (var post in Model)
    {
      var presentation = ForumPostPresentation.Create(post, canReply, isAdmin, returnPath);
      <article class="qz-forum-post" id="post-@post.Id">
        <div class="qz-forum-post__content">
          <partial name="_ForumPostHeader" model="presentation" />
          <partial name="_ForumPostBody" model="presentation" />
          <partial name="_ForumPostAttachments" model="presentation" />
          @if (presentation.HasSignature)
          {
            <footer class="qz-forum-post__signature qz-meta">@post.Signature</footer>
          }
        </div>
        <partial name="_ForumPostActions" model="presentation" />
        @if (canReply)
        {
          <template data-qz-quote-source data-post-author="@post.AuthorUsername">@Html.Raw(UgcHtml.FormatForDisplay(post.Body))</template>
        }
      </article>
    }
  </div>
  <script src="~/js/forum/youtube-scheduler.js" asp-append-version="true" defer></script>
}
