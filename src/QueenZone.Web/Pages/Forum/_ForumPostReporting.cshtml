@model ForumPostPresentation
@{ var post = Model.Post; }
            @if (Model.CanReport)
            {
              @if (post.AlreadyReported)
              {
                <output class="qz-meta">Report submitted</output>
              }
              else
              {
                <a class="qz-forum-post__report-link" href="/forum/post/@post.Id/report?returnUrl=@Model.ReportReturnUrl" rel="nofollow">Report post</a>
              }
              @if (Model.CanBlock)
              {
                @if (post.IsBlocked)
                {
                  <span class="qz-meta">Member blocked</span>
                }
                else
                {
                  <form method="post" action="/forum/post/@post.Id/block" class="admin-inline-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@(Model.ReturnPath)" />
                    <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Block member", $"Block {post.AuthorUsername}?", "They will no longer be able to contact you privately.", TriggerClass: "qz-link-button", ConfirmLabel: "Block"))" />
                  </form>
                }
              }
            }
