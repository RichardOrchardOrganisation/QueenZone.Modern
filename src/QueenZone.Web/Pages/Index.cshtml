@page "/"
@model QueenZone.Web.Pages.IndexModel

<h1 class="visually-hidden">QueenZone: Queen news, community and archive</h1>

<partial name="_HomeTicker" model="Model" />

<partial name="_HomeApps" model="Model" />

<section class="qz-home-front" id="news" aria-label="Latest from Queenzone">
  <div class="qz-container qz-home-front__row">

    <div class="qz-home-front__lead">
      <partial name="_HomeLatestPhotos" model="Model" />

      <partial name="_HomeSprintQuiz" model="Model" />

    </div>

    <partial name="_HomeNewsList" model="Model" />

    <div class="qz-home-front__side">
      <partial name="_HomeForumNow" model="Model" />

      <partial name="_HomePollTeaser" model="Model" />

      <partial name="_HomeQuotes" model="Model" />

    </div>
  </div>
</section>

<partial name="_HomeOnThisDay" model="Model" />

<partial name="_HomeForumBand" model="Model" />

<partial name="_HomePoll" model="Model" />

<partial name="_HomeArticles" model="Model" />

<partial name="_HomeArchiveMontage" model="Model" />

@section Scripts {
  <script src="/js/home-archive-hero.js" asp-append-version="true" defer></script>
  <script src="/js/home-live-ticker.js" asp-append-version="true" defer></script>
}
