@page "/messages/compose"
@model QueenZone.Web.Pages.Messages.ComposeModel

<partial name="_PageHero" model='@(("Community", "New message", "Send a private message to another member.", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose qz-messages">
    <p class="qz-messages-nav"><a href="/messages">Back to inbox</a></p>

    @if (Model.Input.RecipientMemberId is null || string.IsNullOrWhiteSpace(Model.SelectedRecipientDisplayName))
    {
      <form method="get" action="/messages/compose" class="qz-account-form">
        <div class="qz-account-form__field">
          <label for="recipient-query">To</label>
          <input id="recipient-query" name="q" value="@Model.Input.RecipientQuery" autocomplete="off" enterkeyhint="search" autocapitalize="none" spellcheck="false" />
          <span class="qz-account-form__field-error">@Html.ValidationMessage("Input.RecipientQuery")</span>
          <p class="qz-account-form__help">Search by display name, then select a match if more than one member shares the name.</p>
        </div>
        <div class="qz-account-form__actions">
          <button class="qz-button qz-button--outline" type="submit">Find member</button>
        </div>
      </form>

      @if (Model.RecipientMatches.Count > 0)
      {
        <ul class="qz-message-recipient-matches">
          @foreach (var match in Model.RecipientMatches)
          {
            <li>
              <a href="/messages/compose?to=@match.MemberId">@match.DisplayName</a>
            </li>
          }
        </ul>
      }
    }

    <form method="post" class="qz-account-form qz-messages-compose">
      <div asp-validation-summary="ModelOnly" class="qz-account-form__errors" role="alert"></div>

      @if (Model.Input.RecipientMemberId is Guid selectedId && !string.IsNullOrWhiteSpace(Model.SelectedRecipientDisplayName))
      {
        <input type="hidden" asp-for="Input.RecipientMemberId" />
        <div class="qz-account-form__field">
          <span>To</span>
          <p>
            <strong>@Model.SelectedRecipientDisplayName</strong>
            · <a href="/messages/compose">Choose someone else</a>
          </p>
        </div>

        <div class="qz-account-form__field">
          <label asp-for="Input.Body"></label>
          <textarea asp-for="Input.Body" rows="8" maxlength="4000" enterkeyhint="send" autocapitalize="sentences"></textarea>
          <span asp-validation-for="Input.Body" class="qz-account-form__field-error"></span>
        </div>

        <div class="qz-account-form__actions">
          <button class="qz-button qz-button--cta" type="submit">Send message</button>
        </div>
      }
      else
      {
        <p class="qz-account-form__help">Select a recipient above before writing your message.</p>
      }
    </form>
  </div>
</section>
