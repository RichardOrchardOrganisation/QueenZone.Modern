@page "/messages/{conversationId:guid}"
@model QueenZone.Web.Pages.Messages.ConversationModel

@{
  var other = Model.Detail?.OtherParticipantDisplayName ?? "Conversation";
}

<partial name="_PageHero" model='@(("Community", other, "Private conversation", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose qz-messages">
    <p class="qz-messages-nav">
      <a href="/messages">Back to inbox</a>
      @if (Model.Detail is not null)
      {
        <text> · </text>
        @if (!string.Equals(Model.Detail.OtherParticipantDisplayName, "Deleted member", StringComparison.Ordinal))
        {
          <a href="/members/@Model.Detail.OtherParticipantId">View profile</a>
        }
      }
    </p>

    @if (Model.Detail is not null)
    {
      @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
      {
        <output class="qz-status-block qz-account-notice qz-account-notice--success">@Model.StatusMessage</output>
      }

      <div class="qz-messages-toolbar">
        <form method="post" asp-page-handler="Archive" class="qz-messages-toolbar__action">
          <button class="qz-button qz-button--ghost" type="submit">Archive conversation</button>
        </form>
        <form method="post" asp-page-handler="Remove" class="qz-messages-toolbar__action">
          <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Remove conversation", "Remove this conversation from your inbox?", TriggerClass: "qz-button qz-button--ghost"))" />
        </form>
        @if (Model.HasBlockedOtherParticipant)
        {
          <form method="post" asp-page-handler="Unblock" class="qz-messages-toolbar__action">
            <button class="qz-button qz-button--ghost" type="submit">Unblock @Model.Detail.OtherParticipantDisplayName</button>
          </form>
        }
        else
        {
          <form method="post" asp-page-handler="Block" class="qz-messages-toolbar__action">
            <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel($"Block {Model.Detail.OtherParticipantDisplayName}", $"Block {Model.Detail.OtherParticipantDisplayName}?", "They will no longer be able to send you private messages.", TriggerClass: "qz-button qz-button--ghost"))" />
          </form>
        }
      </div>

      <partial name="_ArchivePagination" model="Model.Pagination" />

      <div class="qz-message-thread">
        @foreach (var message in Model.Detail.Messages)
        {
          <article class="qz-message-thread__item @(message.IsMine ? "qz-message-thread__item--mine" : null)">
            <header class="qz-message-thread__header">
              <strong>@message.SenderDisplayName</strong>
              <time class="qz-meta" datetime="@message.CreatedAt.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ssZ")">
                @message.CreatedAt.UtcDateTime.ToString("dd MMM yyyy HH:mm") UTC
              </time>
            </header>
            @* Plain text: Razor encoding is the XSS barrier. Do not Html.Raw or auto-link. *@
            <div class="qz-message-thread__body">@message.Body</div>
            @if (!message.IsMine)
            {
              <footer class="qz-message-thread__actions">
                @if (message.ReportedByViewer)
                {
                  <output class="qz-status-block qz-message-thread__reported">Reported</output>
                }
                else
                {
                  <form method="post" asp-page-handler="Report" class="qz-message-report">
                    <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="ReportInput.MessageId" value="@message.Id" />
                    <partial name="_ConfirmDialog" model="@(new ConfirmDialogViewModel("Report message", "Report this message to moderators?", TriggerClass: "qz-message-report__link", IsDanger: false))" />
                  </form>
                }
              </footer>
            }
          </article>
        }
      </div>

      <partial name="_ArchivePagination" model="Model.Pagination" />

      @if (Model.HasBlockedOtherParticipant)
      {
        <output class="qz-status-block qz-account-notice qz-account-notice--error">
          You have blocked this member. They can no longer send you private messages.
        </output>
      }
      else if (!Model.CanSendReply)
      {
        <output class="qz-status-block qz-account-notice qz-account-notice--error">@PrivateMessageService.UnableToSendMessage</output>
      }

      @if (Model.CanSendReply)
      {
        <form method="post" class="qz-account-form qz-messages-reply">
          <div asp-validation-summary="ModelOnly" class="qz-account-form__errors" role="alert"></div>
          <div class="qz-account-form__field">
            <label asp-for="Input.Body"></label>
            <textarea asp-for="Input.Body" rows="5" maxlength="4000" enterkeyhint="send" autocapitalize="sentences"></textarea>
            <span asp-validation-for="Input.Body" class="qz-account-form__field-error"></span>
          </div>
          <div class="qz-account-form__actions">
            <button class="qz-button qz-button--cta" type="submit">Send reply</button>
          </div>
        </form>
      }
    }
  </div>
</section>
