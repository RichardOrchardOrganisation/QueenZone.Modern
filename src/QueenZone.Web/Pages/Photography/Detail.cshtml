@page "/photography/{slug}/{picId:int}"
@model DetailModel

<section class="qz-lightbox"
         data-photo-lightbox
         data-back-href="@Model.BackToGridHref"
         data-prev-href="@Model.PreviousHref"
         data-next-href="@Model.NextHref">
  <div class="qz-breadcrumbs-on-dark">
    <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
  </div>

  <div class="qz-lightbox__header">
    <a class="qz-lightbox__back" href="@Model.BackToGridHref">&larr; Back to @Model.Category.Name</a>
    <span class="qz-lightbox__counter">@(Model.Index + 1) / @Model.Count</span>
  </div>

  <div class="qz-lightbox__body">
    @if (Model.PreviousHref is null)
    {
      <span class="qz-lightbox__arrow is-disabled" aria-hidden="true">&#8249;</span>
    }
    else
    {
      <a class="qz-lightbox__arrow" href="@Model.PreviousHref" rel="prev" aria-label="Previous image" data-lightbox-prev>&#8249;</a>
    }

    @if (Model.Photo.HasPictureDimensions)
    {
      <img class="qz-lightbox__image"
           src="@Model.Photo.ImageUrl"
           alt="@Model.Photo.Title"
           width="@Model.Photo.PictureWidth"
           height="@Model.Photo.PictureHeight"
           draggable="false">
    }
    else
    {
      <img class="qz-lightbox__image" src="@Model.Photo.ImageUrl" alt="@Model.Photo.Title" draggable="false">
    }

    @if (Model.NextHref is null)
    {
      <span class="qz-lightbox__arrow is-disabled" aria-hidden="true">&#8250;</span>
    }
    else
    {
      <a class="qz-lightbox__arrow" href="@Model.NextHref" rel="next" aria-label="Next image" data-lightbox-next>&#8250;</a>
    }
  </div>

  <figcaption class="qz-lightbox__caption">
    <h1>@Model.Photo.Title</h1>
    <p class="qz-lightbox__meta">
      @Model.Photo.Year &middot; @Model.Category.Name
      @if (Model.Photo.PictureDimensionsLabel is string dimensions)
      {
        <text> &middot; @dimensions</text>
      }
      @if (!string.IsNullOrWhiteSpace(Model.Photo.SubmittedByDisplayName))
      {
        <text> &middot; Submitted by @Model.Photo.SubmittedByDisplayName</text>
      }
    </p>
    @if (Model.ArchiveNotes.Count > 0)
    {
      <ul class="qz-lightbox__meta" aria-label="Archive notes">
        @foreach (var note in Model.ArchiveNotes)
        {
          <li>@note.Text</li>
        }
      </ul>
    }
    <p class="qz-lightbox__meta">
      <a href="/submit/photo-correction/@Model.Photo.PicId">Suggest a correction</a>
    </p>
    <partial name="_SocialShare" />
  </figcaption>
</section>
