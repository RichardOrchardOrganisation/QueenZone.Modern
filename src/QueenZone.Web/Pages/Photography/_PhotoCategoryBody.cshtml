@model PhotoCategoryPageModel
@using QueenZone.Data

<partial name="_PageHero" model='@(("Photography", Model.Category.Name, $"Part of the Queenzone photographic archive — {Model.Category.ImageCount:N0} images.", ""))' />

<section class="qz-section">
  <div class="qz-container">
    <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />

    <nav class="qz-photo-filters" aria-label="Filter photos by size">
      @foreach (var preset in PhotoListFilter.AllPresets)
      {
        var filter = new PhotoListFilter(preset.Size);
        var href = PhotoRoutes.GetCategoryPagePath(Model.Category.Slug, Model.CurrentPage, filter);
        var isActive = Model.SizeFilter.Size == preset.Size;
        <a class="qz-photo-filters__chip@(isActive ? " is-active" : null)"
           href="@href"
           aria-current="@(isActive ? "true" : null)">@preset.Label</a>
      }
    </nav>

    @if (Model.TotalCount == 0)
    {
      @if (Model.SizeFilter.IsActive)
      {
        <p class="qz-photo-empty">
          No images match <strong>@Model.SizeFilter.Label</strong> in this collection.
          <a href="@PhotoRoutes.GetCategoryPagePath(Model.Category.Slug, Model.CurrentPage)">Show all sizes</a>
        </p>
      }
      else
      {
        <p>No images are available in this collection yet.</p>
      }
    }
    else
    {
      <p class="qz-photo-range">
        Showing @Model.RangeStart&ndash;@Model.RangeEnd of @Model.TotalCount
        @if (Model.SizeFilter.IsActive)
        {
          <text> matching @Model.SizeFilter.Label</text>
        }
      </p>
      <partial name="_PhotoThumbnailGrid" model="Model.Items" />
      <partial name="_ArchivePagination" model="PhotoRoutes.GetCategoryPaginationViewModel(Model.Category.Slug, Model.CurrentPage, Model.TotalPages, Model.SizeFilter)" />
    }
  </div>
</section>
