@page "/quizzes/leaderboard"
@model LeaderboardModel
@using QueenZone.Data
@{
  var allTime = Model.Scope == QuizSprintBoardScope.AllTime;
}

<section class="qz-sprint-results qz-band-dark">
  <partial name="_PictureImage" model='@(("/design-system/assets/crest-white.png", "", false, "qz-sprint-results__crest"))' />
  <div class="qz-container">
    <p class="qz-sprint__eyebrow">Quiz Sprint</p>
    <h1 class="qz-sprint-intro__title">@(allTime ? "All-time leaderboard" : "Today's leaderboard")</h1>
    <p class="qz-sprint-intro__standfirst">
      @(allTime
        ? "Each member's single best sixty-second run, ever."
        : "Each member's best sixty-second run today. The board resets at midnight UTC.")
    </p>
    <div class="qz-sprint__buttons"><a class="qz-sprint__cta" href="/quizzes/sprint">Play the sprint</a></div>
  </div>
</section>

<section class="qz-section qz-section--warm">
  <div class="qz-container">
    <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />
    <nav class="qz-sprint-tabs" aria-label="Leaderboard period">
      <a class="qz-sprint-tabs__tab@(allTime ? "" : " qz-sprint-tabs__tab--active")" href="/quizzes/leaderboard" aria-current="@(allTime ? null : "page")">Today</a>
      <a class="qz-sprint-tabs__tab@(allTime ? " qz-sprint-tabs__tab--active" : "")" href="/quizzes/leaderboard?scope=all" aria-current="@(allTime ? "page" : null)">All time</a>
    </nav>
    <partial name="_SprintBoard" model='@((Model.Board, false, allTime ? "No Sprint scores yet. Be the first on the board." : "No scores yet today. Be the first on the board."))' />
    <p class="qz-quiz-leaderboard__total">@Model.Board.Players member@(Model.Board.Players == 1 ? "" : "s") ranked@(allTime ? "" : " today").</p>
    @if (!Model.SignedIn)
    {
      <p class="qz-quiz-leaderboard__total">Scores are only added for signed-in members. <a href="/account/login?returnUrl=%2Fquizzes%2Fleaderboard">Sign in to be ranked</a>.</p>
    }
  </div>
</section>
