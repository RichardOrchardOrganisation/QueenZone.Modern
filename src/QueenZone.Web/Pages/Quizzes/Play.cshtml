@page "/quizzes/{id:guid}"
@model PlayModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
  var quiz = Model.Quiz!;
}

<partial name="_PageHero" model='@(("Test yourself", quiz.Title, quiz.Description ?? "", ""))' />

<section class="qz-section">
  <div class="qz-container">
    <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />

    @if (Model.Result is { } result)
    {
      <div class="qz-quiz-result" aria-live="polite">
        <p class="qz-quiz-result__score">@result.Score / @result.MaxScore points &middot; @result.CorrectCount / @result.QuestionCount correct</p>

        @if (!Model.ViewerIsSignedIn)
        {
          <p class="qz-quiz-result__notice">
            <a href="/account/login?returnUrl=@Uri.EscapeDataString($"/quizzes/{quiz.Id}")">Sign in</a>
            to have this result count toward the leaderboard.
          </p>
        }

        <ol class="qz-quiz-result__list">
          @foreach (var answer in result.Answers)
          {
            <li class="qz-quiz-result__item qz-quiz-result__item--@(answer.IsCorrect ? "correct" : "incorrect")">
              <p class="qz-quiz-result__question">@answer.QuestionText</p>
              <p class="qz-quiz-result__answer">
                @if (answer.SelectedOptionText is not null)
                {
                  <span>Your answer: @answer.SelectedOptionText</span>
                }
                else
                {
                  <span>You did not answer this question.</span>
                }
              </p>
              @if (!answer.IsCorrect)
              {
                <p class="qz-quiz-result__correct-answer">Correct answer: @answer.CorrectOptionText</p>
              }
            </li>
          }
        </ol>

        <div class="admin-form-actions">
          <a class="qz-button qz-button--secondary" href="/quizzes">More quizzes</a>
          <a class="qz-button qz-button--cta" href="/quizzes/leaderboard">View the leaderboard</a>
        </div>
      </div>
    }
    else
    {
      <form method="post" class="qz-quiz-form">
        <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken">

        @foreach (var question in quiz.Questions)
        {
          <fieldset class="qz-quiz-form__question">
            <legend>@question.Text</legend>
            <ul class="qz-poll__options">
              @foreach (var option in question.Options)
              {
                <li>
                  <label class="qz-poll__option">
                    <input class="visually-hidden" type="radio" name="answer_@question.Id.ToString("N")" value="@option.Id.ToString("N")" required>
                    <span class="qz-poll__option-content">
                      <span class="qz-poll__indicator qz-poll__indicator--circle">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
                      </span>
                      <span class="qz-poll__label">@option.Text</span>
                    </span>
                  </label>
                </li>
              }
            </ul>
          </fieldset>
        }

        <div class="admin-form-actions">
          <button type="submit" class="qz-button qz-button--cta">Submit answers</button>
        </div>
      </form>
    }
  </div>
</section>
