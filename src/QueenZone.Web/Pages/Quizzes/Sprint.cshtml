@page "/quizzes/sprint"
@model SprintModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
  var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<partial name="_PageHero" model='@(("Test yourself", "Quiz Sprint", "How many Queen questions can you answer in 60 seconds?", ""))' />

<section class="qz-section">
  <div class="qz-container">
    <partial name="_Breadcrumbs" model="Model.Breadcrumbs" />

    @if (Model.Result is { } result)
    {
      <div class="qz-quiz-result">
        <h2>Round complete</h2>
        <p class="qz-quiz-result__score">@result.Correct correct from @result.Attempted answered</p>
        <p>Wrong answers score zero. There is no point deduction.</p>
        @if (result.Answers.Count > 0)
        {
          <h3>Your answers</h3>
          <ol class="qz-quiz-result__list">
            @foreach (var answer in result.Answers)
            {
              <li class="qz-quiz-result__item qz-quiz-result__item--@(answer.IsCorrect ? "correct" : "incorrect")">
                <p class="qz-quiz-result__question">@answer.QuestionText</p>
                <p class="qz-quiz-result__answer">@(answer.IsCorrect ? "Correct" : "Incorrect")</p>
                @if (!answer.IsCorrect)
                {
                  <p class="qz-quiz-result__correct-answer">Correct answer: @answer.CorrectAnswer</p>
                }
              </li>
            }
          </ol>
        }
        <a class="qz-button qz-button--cta" href="/quizzes/sprint">Play again</a>
      </div>
    }
    else if (Model.Expired)
    {
      <div class="qz-quiz-result">
        <h2>Round expired</h2>
        <p>Your answers arrived after the 60-second round ended. Please try again.</p>
        <a class="qz-button qz-button--cta" href="/quizzes/sprint">Play again</a>
      </div>
    }
    else if (Model.Ticket is { } ticket)
    {
      <div class="qz-sprint" data-sprint-game data-server-now="@Model.ServerNowUnixMilliseconds" data-expires-at="@Model.ExpiresAtUnixMilliseconds">
        <div class="qz-sprint__timer" role="timer" aria-label="Time remaining">
          <div class="qz-sprint__timer-row">
            <span>Time remaining</span>
            <output class="qz-sprint__seconds" data-sprint-seconds>60s</output>
          </div>
          <div class="qz-sprint__track" role="progressbar" aria-label="Time remaining" aria-valuemin="0" aria-valuemax="60" aria-valuenow="60" data-sprint-progress>
            <span class="qz-sprint__fill" data-sprint-fill></span>
          </div>
          <span class="visually-hidden" aria-live="polite" data-sprint-announcement></span>
        </div>

        <form method="post" asp-page-handler="Finish" data-sprint-form>
          <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken">
          <input type="hidden" name="ticket" value="@ticket">
          <p class="qz-sprint__counter" data-sprint-counter>Question 1 of @Model.Questions.Count</p>
          @for (var index = 0; index < Model.Questions.Count; index++)
          {
            var question = Model.Questions[index];
            <fieldset class="qz-quiz-form__question qz-sprint__question" data-sprint-question hidden="@(index != 0)">
              <legend tabindex="-1">@question.Text</legend>
              <ul class="qz-poll__options">
                @foreach (var option in question.Options)
                {
                  <li>
                    <label class="qz-poll__option">
                      <input class="visually-hidden" type="radio" name="answer_@question.Id.ToString("N")" value="@option.Id.ToString("N")">
                      <span class="qz-poll__option-content">
                        <span class="qz-poll__indicator qz-poll__indicator--circle">
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
                        </span>
                        <span class="qz-poll__label">@option.Text</span>
                      </span>
                    </label>
                  </li>
                }
              </ul>
            </fieldset>
          }
          <div class="qz-sprint__actions">
            <button type="button" class="qz-button qz-button--secondary" data-sprint-skip>Skip question</button>
            <button type="submit" class="qz-button qz-button--cta" data-sprint-finish>Finish round</button>
          </div>
        </form>
        <noscript><p>JavaScript is required to advance questions and show the countdown.</p></noscript>
      </div>
    }
    else
    {
      <div class="qz-quiz-result">
        <h2>Ready for a quick round?</h2>
        <p>You have 60 seconds to answer as many random questions from published Queen quizzes as you can. Each correct answer earns one point. Wrong or skipped answers earn zero, with no deduction.</p>
        <p>This is a casual round; results do not appear on the leaderboard.</p>
        @if (Model.EmptyPool)
        {
          <p>No published questions are available yet.</p>
        }
        else
        {
          <form method="post" asp-page-handler="Start">
            <input type="hidden" name="__RequestVerificationToken" value="@antiforgeryToken">
            <button type="submit" class="qz-button qz-button--cta">Start 60-second sprint</button>
          </form>
        }
      </div>
    }
  </div>
</section>

@section Scripts {
  <script src="~/js/quiz-sprint.js" asp-append-version="true" defer></script>
}
