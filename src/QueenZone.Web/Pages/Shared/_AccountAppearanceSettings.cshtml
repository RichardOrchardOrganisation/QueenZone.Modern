@model QueenZone.Web.Pages.Account.SettingsModel
<section class="qz-account-settings__legacy" aria-labelledby="appearance-heading">
  <h2 id="appearance-heading" class="qz-account-settings__section-title">Appearance</h2>
  <p>
    By default QueenZone follows your device's light or dark setting. Choose Light or Dark to
    override it. This is saved to your account, so it also applies on the mobile app.
  </p>
  <form method="post"
        asp-page-handler="UpdateThemePreference"
        class="qz-account-form"
        data-busy-submit
        data-busy-label="Saving…">
    @Html.AntiForgeryToken()
    <fieldset class="qz-account-form__legacy-choices">
      <legend class="qz-account-form__legend">Colour theme</legend>
      <label class="qz-account-form__radio">
        <input asp-for="ThemePreference" type="radio" value="@MemberThemePreference.System" />
        <span>Use device setting</span>
      </label>
      <label class="qz-account-form__radio">
        <input asp-for="ThemePreference" type="radio" value="@MemberThemePreference.Light" />
        <span>Light</span>
      </label>
      <label class="qz-account-form__radio">
        <input asp-for="ThemePreference" type="radio" value="@MemberThemePreference.Dark" />
        <span>Dark</span>
      </label>
    </fieldset>
    <div class="qz-account-form__actions">
      <button type="submit" class="qz-button">Save appearance</button>
    </div>
    <output class="qz-status-block qz-account-form__status" data-busy-status hidden aria-live="polite"></output>
  </form>
  <p>
    You can also set this browser differently from your account. It applies to this device only,
    including when you are signed out, and other devices keep following your account.
  </p>
  <form method="post"
        asp-page-handler="UpdateDeviceTheme"
        class="qz-account-form"
        data-busy-submit
        data-busy-label="Saving…">
    @Html.AntiForgeryToken()
    <fieldset class="qz-account-form__legacy-choices">
      <legend class="qz-account-form__legend">This device only</legend>
      <label class="qz-account-form__radio">
        <input asp-for="DeviceTheme" type="radio" value="@DeviceThemeChoice.Account" />
        <span>Same as my account</span>
      </label>
      <label class="qz-account-form__radio">
        <input asp-for="DeviceTheme" type="radio" value="@DeviceThemeChoice.System" />
        <span>System on this device</span>
      </label>
      <label class="qz-account-form__radio">
        <input asp-for="DeviceTheme" type="radio" value="@DeviceThemeChoice.Light" />
        <span>Light on this device</span>
      </label>
      <label class="qz-account-form__radio">
        <input asp-for="DeviceTheme" type="radio" value="@DeviceThemeChoice.Dark" />
        <span>Dark on this device</span>
      </label>
    </fieldset>
    <div class="qz-account-form__actions">
      <button type="submit" class="qz-button">Save for this device</button>
    </div>
    <output class="qz-status-block qz-account-form__status" data-busy-status hidden aria-live="polite"></output>
  </form>
</section>
