@model QueenZone.Web.Pages.Crosswords.CrosswordPlayerViewModel
@using System.Text.Json
@{ var puzzle = Model.Puzzle; }
<section id="crossword-play" class="qz-section qz-crossword" data-crossword>
  <div class="qz-container">
    <nav aria-label="Breadcrumb"><a href="/crosswords">Crosswords</a> / @puzzle.Title</nav>
    <header class="qz-crossword-heading">
      <div><p>@puzzle.Difficulty · @puzzle.Width × @puzzle.Height</p><h1>@puzzle.Title</h1><p>@puzzle.Description</p></div>
      <button type="button" class="qz-button" data-print>Print blank puzzle</button>
    </header>
    @if (puzzle.Archived) { <p class="qz-crossword-banner">Archived puzzle — still available to play.</p> }
    <noscript><p>Turn on JavaScript to enter letters. You can still read the clues and print this blank grid.</p></noscript>
    <div class="qz-crossword-toolbar" hidden data-toolbar>
      <span aria-label="Elapsed time" data-timer>0:00</span>
      <button type="button" data-pause>Pause</button>
      <button type="button" data-play-again>Reset current attempt</button>
      <label><input type="checkbox" data-auto-check /> Auto-check (assisted solve)</label>
      <details data-menu>
        <summary>Check or reveal</summary>
        <div class="qz-crossword-menu">
          @foreach (var scope in new[] { "cell", "entry", "grid" })
          {
            var label = scope == "entry" ? "word" : scope;
            <button type="button" data-check="@scope">Check @label</button>
            <button type="button" data-reveal="@scope">Reveal @label</button>
          }
        </div>
      </details>
    </div>
    <output class="qz-status-block" aria-live="polite" data-status></output>
    <button type="button" class="qz-button" data-check="grid" data-check-shortcut hidden>Check grid</button>
    <p data-practice hidden>Practice on this device. Your saved attempt and first leaderboard result are preserved. <button type="button" class="qz-button" data-resume-saved>Resume saved attempt</button></p>
    <div class="qz-crossword-layout">
      <div class="qz-crossword-board">
        <p class="qz-crossword-active" id="crossword-active-clue" data-active-clue aria-live="polite">Select a clue to begin.</p>
        <partial name="/Pages/Crosswords/_CrosswordGrid.cshtml" model="puzzle" />
        <label class="visually-hidden" for="crossword-input">Type a letter in the selected cell</label>
        <input class="qz-crossword-input visually-hidden" id="crossword-input" data-input type="text" inputmode="text" autocapitalize="characters" autocomplete="off" autocorrect="off" spellcheck="false" aria-describedby="crossword-active-clue" />
        <div class="qz-crossword-pause" data-paused hidden><h2>Paused</h2><p>The timer has stopped and your letters are hidden.</p><button type="button" data-resume>Resume crossword</button></div>
        <div class="qz-crossword-completion" data-completion hidden>
          <h2>Crossword complete</h2><p data-completion-message></p>
          <button type="button" data-play-again>Play again</button><button type="button" data-share>Share result</button><a href="/crosswords">Next crossword</a>
          @if (!Model.Preview) { <a href="/crosswords/@puzzle.Slug/leaderboard">Leaderboard</a> }
          @if (Model.MemberId is null) { <p><a href="/account/login?returnUrl=@Uri.EscapeDataString("/crosswords/" + puzzle.Slug)">Sign in to save progress across devices</a></p> }
        </div>
      </div>
      <partial name="/Pages/Crosswords/_CrosswordClues.cshtml" model="puzzle" />
    </div>
    <section data-review hidden aria-label="Clue explanations"><h2>Clue explanations</h2><dl data-review-list></dl></section>
    @if (!Model.OfflineShell) { <form hidden data-antiforgery>@Html.AntiForgeryToken()</form> }
    <script type="application/json" data-puzzle>@Html.Raw(JsonSerializer.Serialize(new { puzzle, memberId = Model.MemberId, offlineShell = Model.OfflineShell, preview = Model.Preview }, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
  </div>
</section>
