@using Microsoft.Extensions.Options
@using QueenZone.Web.Sitemap
@inject IOptions<SiteOptions> SiteOptionsAccessor
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"]</title>
  @if (ViewData["CanonicalPath"] is string canonicalPath)
  {
    <link rel="canonical" href="@SiteUrl.ToAbsolute(SiteOptionsAccessor.Value.PublicBaseUrl, canonicalPath)">
  }
  @if (ViewData["PrevPath"] is string prevPath)
  {
    <link rel="prev" href="@SiteUrl.ToAbsolute(SiteOptionsAccessor.Value.PublicBaseUrl, prevPath)">
  }
  @if (ViewData["NextPath"] is string nextPath)
  {
    <link rel="next" href="@SiteUrl.ToAbsolute(SiteOptionsAccessor.Value.PublicBaseUrl, nextPath)">
  }
  @if (ViewData["Robots"] is string robotsContent)
  {
    <meta name="robots" content="@robotsContent">
  }
  @if (ViewData["Description"] is string description)
  {
    <meta name="description" content="@description">
  }
  @if (ViewData["RssFeedPath"] is string rssFeedPath)
  {
    var rssTitle = ViewData["RssFeedTitle"] as string ?? "RSS";
    <link rel="alternate" type="application/rss+xml" title="@rssTitle" href="@SiteUrl.ToAbsolute(SiteOptionsAccessor.Value.PublicBaseUrl, rssFeedPath)">
  }
  @if (ViewData["CanonicalPath"] is string ogCanonicalPath)
  {
    var ogType = ViewData["OgType"] is string ot ? ot : "website";
    <meta property="og:site_name" content="QueenZone">
    <meta property="og:type" content="@ogType">
    <meta property="og:url" content="@SiteUrl.ToAbsolute(SiteOptionsAccessor.Value.PublicBaseUrl, ogCanonicalPath)">
    if (ViewData["Title"] is string ogTitle)
    {
      <meta property="og:title" content="@ogTitle">
    }
    if (ViewData["Description"] is string ogDesc)
    {
      <meta property="og:description" content="@ogDesc">
    }
    if (ViewData["OgImage"] is string ogImage)
    {
      <meta property="og:image" content="@ogImage">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content="@ogImage">
    }
    else
    {
      <meta name="twitter:card" content="summary">
    }
  }
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <partial name="_PwaHead" />
  <link rel="preload" href="/design-system/fonts/inter-latin-400-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/design-system/fonts/cormorant-garamond-latin-300-700.woff2" as="font" type="font/woff2" crossorigin>
  <environment include="Development">
    <link rel="stylesheet" href="/design-system/tokens/fonts.css" asp-append-version="true">
    <link rel="stylesheet" href="/design-system/tokens/colors.css" asp-append-version="true">
    <link rel="stylesheet" href="/design-system/tokens/typography.css" asp-append-version="true">
    <link rel="stylesheet" href="/design-system/tokens/spacing.css" asp-append-version="true">
    <link rel="stylesheet" href="/design-system/tokens/base.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
  </environment>
  <environment exclude="Development">
    <link rel="stylesheet" href="/design-system/tokens/tokens.min.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/site.min.css" asp-append-version="true">
  </environment>
@await RenderSectionAsync("Head", required: false)
</head>
<body>
  <a class="qz-skip-link" href="#main-content">Skip to content</a>
  <partial name="_EnvironmentBanner" />
  <partial name="_SiteHeader" />
  <main id="main-content" tabindex="-1">
    @RenderBody()
  </main>
  <partial name="_SiteFooter" />
  <partial name="_BuildStamp" />
  <script src="/js/site.js" asp-append-version="true" defer></script>
  @await RenderSectionAsync("Scripts", required: false)
  @* Analytics after body content / site.js so it stays off the LCP critical path. *@
  <partial name="_GoogleAnalytics" />
</body>
</html>


