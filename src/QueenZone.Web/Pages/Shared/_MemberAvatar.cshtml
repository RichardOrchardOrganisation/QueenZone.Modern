@model QueenZone.Web.MemberAvatarViewModel
@{
  var sizeClass = Model.Size switch
  {
    "md" => "qz-avatar--md",
    "lg" => "qz-avatar--lg",
    _ => "qz-avatar--sm",
  };
}

@if (Model.ImageUrl is not null)
{
  <img class="qz-avatar qz-avatar--image @sizeClass"
       src="@Model.ImageUrl"
       alt="@Model.AltText"
       width="@(Model.UseThumbnail || Model.Size == "sm" ? 32 : 64)"
       height="@(Model.UseThumbnail || Model.Size == "sm" ? 32 : 64)"
       loading="lazy"
       decoding="async" />
}
else
{
  <svg class="qz-avatar qz-avatar--initials @sizeClass"
        data-avatar-bg="@Model.InitialsBackgroundCss"
        role="img"
        aria-label="@Model.AltText" focusable="false">
    <text x="50%" y="50%" text-anchor="middle" dominant-baseline="central" fill="currentColor">@Model.Initials</text>
  </svg>
}
