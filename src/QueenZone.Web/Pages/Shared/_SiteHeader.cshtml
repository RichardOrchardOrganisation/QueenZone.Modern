@{
    var header = await SiteHeaderPresentation.CreateAsync(
        Context, ViewData["MastheadDark"] as bool?, ViewData["ShowAdminNav"] is true);
}

<header class="qz-masthead @(header.MastheadDark ? "qz-masthead--dark" : "qz-masthead--light")" data-masthead>
  <div class="qz-masthead__inner">
    <a class="qz-brand" href="/">
      <partial name="_PictureImage" model="@(header.MastheadDark ? "/design-system/assets/crest-white.png" : "/design-system/assets/crest-black.png", "Queen crest", false, "qz-brand__crest")" />
      <span>Queenzone.org</span>
    </a>

<partial name="_SiteHeaderDesktopNavigation" model="header" />

<partial name="_SiteHeaderDesktopActions" model="header" />

  </div>

  <dialog class="qz-mobile-menu" id="qz-mobile-menu" aria-label="Primary navigation" hidden data-mobile-menu>
    <div class="qz-mobile-menu__scrim" data-menu-close></div>
    <div class="qz-mobile-menu__panel">
      <div class="qz-mobile-menu__top">
        <button class="qz-icon-button" type="button" aria-label="Close navigation menu" data-menu-close>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
        <a class="qz-icon-button" href="/search" aria-label="Search">
          <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
        </a>
      </div>
<partial name="_SiteHeaderMobileAccount" model="header" />

<partial name="_SiteHeaderMobileNavigation" model="header" />

    </div>
  </dialog>
</header>

