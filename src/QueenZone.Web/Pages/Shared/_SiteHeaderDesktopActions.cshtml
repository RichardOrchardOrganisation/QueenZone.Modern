@model SiteHeaderViewModel
    <div class="qz-masthead__actions">
      <partial name="_ThemeChooser" />
      <a class="qz-icon-button" href="/search" aria-label="Search" aria-current="@(Model.IsActive("/search") ? "page" : null)">
        <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
      </a>
      <partial name="_SiteHeaderMessagesIcon" model="Model" />
      <partial name="_SiteHeaderAdminIdentity" model="Model" />
      <partial name="_SiteHeaderDesktopAccount" model="Model" />
      <button class="qz-menu-button" type="button" aria-label="Open navigation menu" aria-controls="qz-mobile-menu" aria-expanded="false" data-menu-open>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
