@model SiteHeaderViewModel
      @if (Model.MemberDisplayName is not null)
      {
        <a class="qz-icon-button qz-masthead__messages-icon" href="/messages" aria-label="@Model.MessagesIconLabel" aria-current="@(Model.IsActive("/messages") ? "page" : null)">
          <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          @if (Model.UnreadMessageCount > 0)
          {
            <span class="qz-masthead__unread" aria-hidden="true">@Model.UnreadMessageCount</span>
          }
        </a>
      }
