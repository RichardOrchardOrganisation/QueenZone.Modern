@model SiteHeaderViewModel
      <nav class="qz-mobile-nav" aria-label="Mobile primary navigation">
        @foreach (var group in Model.NavigationGroups)
        {
          <section class="qz-mobile-nav__section qz-nav-group--@group.Accent" aria-labelledby="qz-mobile-nav-@group.Id">
            <h2 id="qz-mobile-nav-@group.Id">@group.Label</h2>
            <p>@group.Eyebrow</p>
            <ul>
              @foreach (var item in group.Items)
              {
                <li>
                  <a href="@item.Href" aria-current="@(Model.IsActive(item.Href) ? "page" : null)">
                    <span>@item.Title</span>
                    @if (!string.IsNullOrWhiteSpace(item.Tag))
                    {
                      <span class="qz-nav-panel__tag">@item.Tag</span>
                    }
                  </a>
                </li>
              }
            </ul>
          </section>
        }
        <section class="qz-mobile-nav__section qz-nav-group--gold" aria-labelledby="qz-mobile-nav-quiz">
          <h2 id="qz-mobile-nav-quiz">Quiz</h2>
          <p>The Daily Challenge</p>
          <ul>
            <li>
              <a href="/quizzes/sprint" aria-current="@(Model.IsActive("/quizzes") ? "page" : null)"><span>Quiz Sprint</span></a>
            </li>
          </ul>
        </section>
      </nav>
