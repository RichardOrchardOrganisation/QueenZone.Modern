@page "/submit/trivia/confirmation/{id:guid}"
@model TriviaConfirmationModel

@{
  var submission = Model.Submission!;
}

<partial name="_PageHero" model='@(("Community", "Trivia fact submitted", "Your trivia fact is under review.", ""))' />

<section class="qz-section">
  <div class="qz-container qz-prose">
    <output class="qz-status-block qz-account-notice qz-account-notice--success">Your trivia fact is under review.</output>

    <div class="qz-account-settings">
      <dl class="qz-account-settings__meta">
        <div>
          <dt>Fact</dt>
          <dd>@submission.Text</dd>
        </div>
        @if (!string.IsNullOrWhiteSpace(submission.Category))
        {
          <div>
            <dt>Category</dt>
            <dd>@submission.Category</dd>
          </div>
        }
        @if (!string.IsNullOrWhiteSpace(submission.Difficulty))
        {
          <div>
            <dt>Difficulty</dt>
            <dd>@submission.Difficulty</dd>
          </div>
        }
        <div>
          <dt>Status</dt>
          <dd>@submission.Status</dd>
        </div>
        <div>
          <dt>Submitted</dt>
          <dd>@submission.SubmittedAt.ToString("u")</dd>
        </div>
      </dl>
    </div>

    <p>
      <a href="/account/my-submissions?tab=trivia">View your submissions</a>
      ·
      <a href="/submit/trivia">Suggest another fact</a>
    </p>
  </div>
</section>
