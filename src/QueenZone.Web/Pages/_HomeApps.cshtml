@model QueenZone.Web.Pages.IndexModel
<section class="qz-home-apps" aria-label="Queenzone mobile apps">
  <div class="qz-container qz-home-apps__inner">
    <span class="qz-home-apps__icon" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        <rect x="7" y="2" width="10" height="20" rx="2"></rect>
        <path d="M10 5h4M11 19h2"></path>
      </svg>
    </span>
    <div class="qz-home-apps__copy">
      <p class="qz-home-apps__eyebrow">iPhone on the App Store &middot; Android on Google Play</p>
      <h2 class="qz-home-apps__title">Queenzone in your pocket</h2>
      <p class="qz-home-apps__body">News, the forum, the photo galleries and home-screen widgets for trivia, quotes and On This Day.</p>
    </div>
    <div class="qz-home-apps__actions">
      <a class="qz-button qz-button--cta qz-home-apps__cta" href="https://apps.apple.com/au/app/queenzone-org/id6803889011" target="_blank" rel="noopener noreferrer" aria-label="Download QueenZone for iPhone on the App Store">Get it on the App Store</a>
      <a class="qz-button qz-button--cta qz-home-apps__cta" href="https://play.google.com/store/apps/details?id=org.queenzone.mobile" target="_blank" rel="noopener noreferrer" aria-label="Download QueenZone for Android on Google Play">Get it on Google Play</a>
      <a class="qz-home-apps__details" href="/mobile-apps">Explore the mobile apps</a>
    </div>
  </div>
</section>
