<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\QueenZone.Data\QueenZone.Data.csproj" />
    <ProjectReference Include="..\QueenZone.NewsAgent\QueenZone.NewsAgent.csproj" />
    <ProjectReference Include="..\QueenZone.Search.Shared\QueenZone.Search.Shared.csproj" />
    <ProjectReference Include="..\QueenZone.Storage\QueenZone.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNet.Security.OAuth.Apple" />
    <PackageReference Include="AspNet.Security.OAuth.Discord" />
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Google.Analytics.Data.V1Beta" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</RepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QueenZone.Web.Tests" />
    <Using Include="QueenZone.Routing" />
    <Using Include="QueenZone.Search.Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- Token CSS is bundled in this order, then it and site.css get minified at publish time.
         See the BundleCss and MinifyCss targets below.
         Forward slashes only: this path is concatenated with $(PublishDir) and handed
         to a shell command, and CI publishes on Linux where "\" is not a separator. -->
    <TokenCss Include="wwwroot/design-system/tokens/fonts.css" />
    <TokenCss Include="wwwroot/design-system/tokens/colors.css" />
    <TokenCss Include="wwwroot/design-system/tokens/typography.css" />
    <TokenCss Include="wwwroot/design-system/tokens/spacing.css" />
    <TokenCss Include="wwwroot/design-system/tokens/base.css" />
    <CssToMinify Include="wwwroot/design-system/tokens/tokens.css" />
    <CssToMinify Include="wwwroot/css/site.css" />
  </ItemGroup>

  <!-- Generate only in the publish directory so build artifacts never dirty the source tree. -->
  <Target Name="BundleCss">
    <Exec Command="dotnet run --project &quot;$(RepositoryRoot)/src/QueenZone.Tools/QueenZone.Tools.csproj&quot; -c Release -- bundle-css &quot;$(PublishDir)wwwroot/design-system/tokens/tokens.css&quot; @(TokenCss -> '&quot;$(PublishDir)%(Identity)&quot;', ' ')" />
  </Target>

  <!-- Runs after the publish output (including wwwroot) has been copied to $(PublishDir). -->
  <Target Name="MinifyCss" AfterTargets="Publish" DependsOnTargets="BundleCss">
    <Exec Command="dotnet run --project &quot;$(RepositoryRoot)/src/QueenZone.Tools/QueenZone.Tools.csproj&quot; -c Release -- minify-css @(CssToMinify -> '&quot;$(PublishDir)%(Identity)&quot;', ' ')" />
  </Target>

  <Target Name="SetBuildMetadata" BeforeTargets="GetAssemblyVersion;GetAssemblyAttributes;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" WorkingDirectory="$(RepositoryRoot)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitShort" />
    </Exec>
    <PropertyGroup>
      <GitCommitShort>$([System.String]::Copy('$(GitCommitShort)').Trim())</GitCommitShort>
      <GitCommitShort Condition="'$(OverrideGitCommitShort)' != ''">$(OverrideGitCommitShort)</GitCommitShort>
      <GitCommitShort Condition="'$(GitCommitShort)' == ''">local</GitCommitShort>
      <BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("o"))</BuildTimestampUtc>
      <InformationalVersion>$(GitCommitShort)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTimestampUtc</_Parameter1>
        <_Parameter2>$(BuildTimestampUtc)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
