<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.NUnit" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <!--
      RealData write fixtures (e.g. CommunitySubmissionWorkflowTests) seed and clean up rows
      directly via EF against the SQL Express mirror, the same way EfContentSubmissionLiveProbeTests
      does in QueenZone.Web.Tests. QueenZone.Data has no ASP.NET dependency, so this does not pull
      the web app into the E2E suite or affect the Deterministic (DB-free) default run.
    -->
    <ProjectReference Include="..\..\src\QueenZone.Data\QueenZone.Data.csproj" />
    <ProjectReference Include="..\..\src\QueenZone.Search.Shared\QueenZone.Search.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
